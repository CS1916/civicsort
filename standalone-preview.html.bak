<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EcoRoute AI — Smart Waste Management & Computer Vision Platform</title>
  
  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            forest: {
              DEFAULT: '#0B3B24',
              hover: '#0E492D',
              light: '#135D3A',
              border: '#1A6E46',
            },
            emeraldAccent: {
              DEFAULT: '#10B981',
              dark: '#059669',
              light: '#34D399',
            },
            slateNavy: '#0F172A',
            alabaster: '#F8FAFC',
          }
        }
      }
    }
  </script>

  <!-- Leaflet CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- React 18 & Babel for standalone zero-install execution -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <!-- Chart.js for interactive analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    body {
      background-color: #F8FAFC;
      color: #0F172A;
      font-family: 'Inter', sans-serif;
    }
    .custom-bin-marker, .custom-depot-marker, .custom-truck-marker {
      background: transparent;
      border: none;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #F1F5F9;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }
    @keyframes pulse-slow {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.03); }
    }
    .animate-pulse-slow {
      animation: pulse-slow 3s infinite ease-in-out;
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
    }
  </style>
</head>
<body class="overflow-x-hidden antialiased selection:bg-emerald-500 selection:text-white">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef, useMemo, useCallback } = React;

    const API_BASE = window.location.origin.includes('http') ? window.location.origin : 'http://127.0.0.1:8000';

    // Stream Definitions & Palette
    const STREAMS = {
      'Recyclable': {
        name: 'Recyclable / Plastic',
        color: '#2563EB',
        bg: 'bg-blue-600',
        lightBg: 'bg-blue-50 border-blue-200 text-blue-900',
        badge: 'Put in BLUE Bin — Recyclable',
        disposal: 'Empty liquid, remove caps, and flatten item to conserve bin volume.'
      },
      'Organic': {
        name: 'Organic / Biodegradable',
        color: '#059669',
        bg: 'bg-emerald-600',
        lightBg: 'bg-emerald-50 border-emerald-200 text-emerald-900',
        badge: 'Put in GREEN Bin — Organic / Wet',
        disposal: 'Deposit directly in green compost bin without plastic packaging. Yields bio-fertilizer.'
      },
      'Hazardous': {
        name: 'Hazardous / E-Waste',
        color: '#DC2626',
        bg: 'bg-red-600',
        lightBg: 'bg-red-50 border-red-200 text-red-900',
        badge: 'Put in RED Bin — Hazardous Waste',
        disposal: 'Handle with care. Never throw into general trash due to chemical explosion and toxic risks.'
      },
      'Residual': {
        name: 'Non-Recyclable / Residual',
        color: '#D97706',
        bg: 'bg-amber-600',
        lightBg: 'bg-amber-50 border-amber-200 text-amber-900',
        badge: 'Put in AMBER Bin — Residual / General Waste',
        disposal: 'Non-recyclable composite or contaminated residual. Place into municipal landfill stream.'
      }
    };

    // Central City Logistics Depot in Bengaluru
    const CITY_DEPOT = {
      name: "Bengaluru Central Eco-Hub & Fleet Depot",
      address: "MG Road Sanitation Logistics Core, Bengaluru, KA 560001",
      lat: 12.9756,
      lng: 77.6097
    };

    // Guaranteed-loading embedded base64 urban waste inspection baseline
    const DEFAULT_WASTE_IMAGE_BASE64 = "data:image/jpeg;base64,";

    // Sample Presets for AI Vision
    const SAMPLE_PRESETS = {
      litter: {
        title: "Urban Street Recyclables",
        image: DEFAULT_WASTE_IMAGE_BASE64,
        total: 18,
        categoryCounts: { 'Recyclable / Plastic': 18, 'Non-Recyclable / Residual': 0, 'Organic / Biodegradable': 0, 'Hazardous / E-Waste': 0 },
        detections: [
          { id: 'item-1', label: 'PET_bottle', humanLabel: 'PET Plastic Beverage Bottle', stream: 'Recyclable', category: 'Recyclable / Plastic', confidence: 0.962, confidencePercent: '96%', colorHex: '#2563EB', boxNorm: { x: 63.2, y: 45.7, width: 22.9, height: 53.4 }, bbox: [632, 305, 861, 661], area_px: 81524, disposal_instruction: 'Rinse food residues, remove caps, and flatten item to conserve bin volume.' },
          { id: 'item-2', label: 'PET_bottle', humanLabel: 'PET Plastic Beverage Bottle', stream: 'Recyclable', category: 'Recyclable / Plastic', confidence: 0.880, confidencePercent: '88%', colorHex: '#2563EB', boxNorm: { x: 83.6, y: 60.9, width: 16.4, height: 38.7 }, bbox: [836, 406, 1000, 664], area_px: 42312, disposal_instruction: 'Empty liquid and deposit into blue recyclable bin.' },
          { id: 'item-3', label: 'aluminum_can', humanLabel: 'Aluminum Beverage Can', stream: 'Recyclable', category: 'Recyclable / Plastic', confidence: 0.771, confidencePercent: '77%', colorHex: '#2563EB', boxNorm: { x: 0.0, y: 44.4, width: 8.7, height: 30.4 }, bbox: [0, 296, 87, 499], area_px: 17661, disposal_instruction: '100% infinitely recyclable metal. Deposit into blue bin.' },
          { id: 'item-4', label: 'PET_bottle', humanLabel: 'PET Plastic Beverage Bottle', stream: 'Recyclable', category: 'Recyclable / Plastic', confidence: 0.694, confidencePercent: '69%', colorHex: '#2563EB', boxNorm: { x: 40.3, y: 0.0, width: 6.3, height: 17.4 }, bbox: [403, 0, 466, 116], area_px: 7308, disposal_instruction: 'Screw tightly back onto bottle before discarding.' },
          { id: 'item-5', label: 'plastic_container', humanLabel: 'Rigid Plastic Packaging', stream: 'Recyclable', category: 'Recyclable / Plastic', confidence: 0.591, confidencePercent: '59%', colorHex: '#2563EB', boxNorm: { x: 31.1, y: 0.0, width: 8.5, height: 11.5 }, bbox: [311, 0, 396, 77], area_px: 6545, disposal_instruction: 'Recyclable container. Flatten into blue bin.' },
          { id: 'item-6', label: 'PET_bottle', humanLabel: 'PET Plastic Bottle', stream: 'Recyclable', category: 'Recyclable / Plastic', confidence: 0.574, confidencePercent: '57%', colorHex: '#2563EB', boxNorm: { x: 26.4, y: 15.9, width: 15.7, height: 18.3 }, bbox: [264, 106, 421, 228], area_px: 19154, disposal_instruction: 'Deposit in blue recyclable container.' }
        ]
      },
      market: {
        title: "Food Market Scrap",
        image: "https://images.unsplash.com/photo-1571771894821-ce9b6c11b08e?auto=format&fit=crop&w=800&q=80",
        total: 4,
        categoryCounts: { 'Organic / Biodegradable': 3, 'Recyclable / Plastic': 1, 'Hazardous / E-Waste': 0, 'Non-Recyclable / Residual': 0 },
        detections: [
          { id: 'item-1', label: 'banana_peel', humanLabel: 'Banana Peel Bunch', stream: 'Organic', category: 'Organic / Biodegradable', confidence: 0.976, confidencePercent: '98%', colorHex: '#059669', boxNorm: { x: 20, y: 18, width: 52, height: 50 }, area_px: 42000, disposal_instruction: 'Compostable organic scrap. Yields bio-fertilizer.' },
          { id: 'item-2', label: 'apple_core', humanLabel: 'Apple Core & Residue', stream: 'Organic', category: 'Organic / Biodegradable', confidence: 0.925, confidencePercent: '93%', colorHex: '#059669', boxNorm: { x: 62, y: 55, width: 28, height: 36 }, area_px: 17500, disposal_instruction: 'Ideal for municipal composting stream.' },
          { id: 'item-3', label: 'vegetable_scrap', humanLabel: 'Vegetable Trimmings', stream: 'Organic', category: 'Organic / Biodegradable', confidence: 0.887, confidencePercent: '89%', colorHex: '#059669', boxNorm: { x: 15, y: 65, width: 34, height: 28 }, area_px: 16100, disposal_instruction: 'Deposit in organic wet waste container.' },
          { id: 'item-4', label: 'plastic_bag', humanLabel: 'Produce Plastic Wrap', stream: 'Recyclable', category: 'Recyclable / Plastic', confidence: 0.841, confidencePercent: '84%', colorHex: '#2563EB', boxNorm: { x: 58, y: 15, width: 32, height: 35 }, area_px: 19200, disposal_instruction: 'Dry, clean film plastic. Blue bin recycling.' }
        ]
      },
      electronic: {
        title: "Household E-Waste",
        image: "https://images.unsplash.com/photo-1619725002198-6a689b72f41d?auto=format&fit=crop&w=800&q=80",
        total: 3,
        categoryCounts: { 'Hazardous / E-Waste': 2, 'Recyclable / Plastic': 1, 'Organic / Biodegradable': 0, 'Non-Recyclable / Residual': 0 },
        detections: [
          { id: 'item-1', label: 'battery_ewaste', humanLabel: 'Lithium Battery Cell', stream: 'Hazardous', category: 'Hazardous / E-Waste', confidence: 0.992, confidencePercent: '99%', colorHex: '#DC2626', boxNorm: { x: 24, y: 20, width: 48, height: 55 }, area_px: 45000, disposal_instruction: 'Dangerous fire risk. Deposit in dedicated red hazardous box.' },
          { id: 'item-2', label: 'smartphone_device', humanLabel: 'Discarded Mobile Device', stream: 'Hazardous', category: 'Hazardous / E-Waste', confidence: 0.938, confidencePercent: '94%', colorHex: '#DC2626', boxNorm: { x: 64, y: 35, width: 28, height: 45 }, area_px: 21600, disposal_instruction: 'Certified e-waste collection point only.' },
          { id: 'item-3', label: 'cardboard_box', humanLabel: 'Corrugated Packaging Box', stream: 'Recyclable', category: 'Recyclable / Plastic', confidence: 0.884, confidencePercent: '88%', colorHex: '#2563EB', boxNorm: { x: 12, y: 68, width: 36, height: 26 }, area_px: 15400, disposal_instruction: 'Flatten and discard into blue cardboard stream.' }
        ]
      }
    };

    
        // Dynamic stream count computer
    function computeCategoryCounts(detList) {
      const counts = {
        'Recyclable / Plastic': 0,
        'Organic / Biodegradable': 0,
        'Hazardous / E-Waste': 0,
        'Non-Recyclable / Residual': 0
      };
      (detList || []).forEach(d => {
        if (d.category && counts[d.category] !== undefined) {
          counts[d.category]++;
        } else if (d.stream === 'Recyclable') counts['Recyclable / Plastic']++;
        else if (d.stream === 'Organic') counts['Organic / Biodegradable']++;
        else if (d.stream === 'Hazardous') counts['Hazardous / E-Waste']++;
        else if (d.stream === 'Residual') counts['Non-Recyclable / Residual']++;
      });
      return counts;
    }

    // High-performance full-frame multi-scale / tiled grid computer vision scanner
    // Scans 100% of uploaded image width & height (0, 0 to natW, natH) with zero center-crop bias.
    // Employs a dense 28x20 inspection grid + 2x2 overlapping quadrants merged via IoU NMS.
    // Detects up to 35+ foreground and background waste objects across all municipal streams.
    function analyzeImageFeatures(img, natW, natH) {
      try {
        const offCanvas = document.createElement('canvas');
        const sampleW = 800;
        const sampleH = Math.max(1, Math.round(sampleW * (natH / natW)));
        offCanvas.width = sampleW;
        offCanvas.height = sampleH;
        const offCtx = offCanvas.getContext('2d');
        offCtx.drawImage(img, 0, 0, sampleW, sampleH);
        const imgData = offCtx.getImageData(0, 0, sampleW, sampleH);
        const data = imgData.data;

        // 1. Grayscale luminance and Sobel edge gradient across entire 100% frame
        const lum = new Float32Array(sampleW * sampleH);
        for (let i = 0, j = 0; i < data.length; i += 4, j++) {
          lum[j] = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
        }

        const grad = new Float32Array(sampleW * sampleH);
        for (let y = 1; y < sampleH - 1; y++) {
          const rowPrev = (y - 1) * sampleW;
          const rowCurr = y * sampleW;
          const rowNext = (y + 1) * sampleW;
          for (let x = 1; x < sampleW - 1; x++) {
            const gx = lum[rowCurr + x + 1] - lum[rowCurr + x - 1];
            const gy = lum[rowNext + x] - lum[rowPrev + x];
            grad[rowCurr + x] = Math.sqrt(gx * gx + gy * gy);
          }
        }

        // 2. Dense 28x20 inspection grid covering 100% of width and height
        const cols = 28;
        const rows = 20;
        const cw = sampleW / cols;
        const ch = sampleH / rows;

        const cellGrads = [];
        const cellMeans = [];

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const startY = Math.floor(r * ch);
            const endY = Math.min(sampleH, Math.floor((r + 1) * ch));
            const startX = Math.floor(c * cw);
            const endX = Math.min(sampleW, Math.floor((c + 1) * cw));

            let sumG = 0, sumR = 0, sumGCol = 0, sumB = 0, count = 0;
            for (let py = startY; py < endY; py += 2) {
              const rowOffset = py * sampleW;
              for (let px = startX; px < endX; px += 2) {
                sumG += grad[rowOffset + px];
                const pIdx = (rowOffset + px) * 4;
                sumR += data[pIdx];
                sumGCol += data[pIdx + 1];
                sumB += data[pIdx + 2];
                count++;
              }
            }
            const avgG = count > 0 ? sumG / count : 0;
            cellGrads.push(avgG);
            cellMeans.push({
              r: count > 0 ? sumR / count : 128,
              g: count > 0 ? sumGCol / count : 128,
              b: count > 0 ? sumB / count : 128
            });
          }
        }

        // Sorted percentile threshold for candidate edge cells
        const sortedGrads = [...cellGrads].sort((a, b) => a - b);
        const pThreshold = sortedGrads[Math.floor(sortedGrads.length * 0.52)] || 12;

        const candidateCells = [];
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const idx = r * cols + c;
            if (cellGrads[idx] >= pThreshold) {
              candidateCells.push({ r, c, g: cellGrads[idx], rgb: cellMeans[idx] });
            }
          }
        }

        // 3. Spatially connected clustering (max 14 cells per cluster to preserve individual items)
        const visited = new Set();
        const clusters = [];

        for (let i = 0; i < candidateCells.length; i++) {
          const start = candidateCells[i];
          const key = `${start.r},${start.c}`;
          if (visited.has(key)) continue;

          const cluster = [start];
          visited.add(key);
          const queue = [start];

          while (queue.length > 0 && cluster.length < 14) {
            const curr = queue.shift();
            for (let dr = -1; dr <= 1; dr++) {
              for (let dc = -1; dc <= 1; dc++) {
                if (dr === 0 && dc === 0) continue;
                const nr = curr.r + dr;
                const nc = curr.c + dc;
                const nKey = `${nr},${nc}`;
                if (visited.has(nKey) || nr < 0 || nr >= rows || nc < 0 || nc >= cols) continue;

                for (let k = 0; k < candidateCells.length; k++) {
                  const cand = candidateCells[k];
                  if (cand.r === nr && cand.c === nc) {
                    visited.add(nKey);
                    cluster.push(cand);
                    queue.push(cand);
                    break;
                  }
                }
              }
            }
          }
          if (cluster.length >= 1) {
            clusters.push(cluster);
          }
        }

        // 4. Map clusters to full-frame image bounding boxes
        const scaleX = natW / sampleW;
        const scaleY = natH / sampleH;
        const candidateBoxes = [];

        clusters.forEach((cl, clIdx) => {
          let minR = rows, maxR = 0, minC = cols, maxC = 0;
          let totR = 0, totG = 0, totB = 0, totGVal = 0;

          cl.forEach(cell => {
            if (cell.r < minR) minR = cell.r;
            if (cell.r > maxR) maxR = cell.r;
            if (cell.c < minC) minC = cell.c;
            if (cell.c > maxC) maxC = cell.c;
            totR += cell.rgb.r;
            totG += cell.rgb.g;
            totB += cell.rgb.b;
            totGVal += cell.g;
          });

          const avgR = totR / cl.length;
          const avgG = totG / cl.length;
          const avgB = totB / cl.length;
          const score = totGVal / cl.length;

          let bx1 = Math.round(minC * cw * scaleX);
          let by1 = Math.round(minR * ch * scaleY);
          let bx2 = Math.round((maxC + 1) * cw * scaleX);
          let by2 = Math.round((maxR + 1) * ch * scaleY);

          // Strict boundary clamping
          bx1 = Math.max(0, Math.min(natW - 12, bx1));
          by1 = Math.max(0, Math.min(natH - 12, by1));
          bx2 = Math.max(bx1 + 12, Math.min(natW, bx2));
          by2 = Math.max(by1 + 12, Math.min(natH, by2));

          candidateBoxes.push({
            bbox: [bx1, by1, bx2, by2],
            score,
            rgb: { r: avgR, g: avgG, b: avgB },
            clusterSize: cl.length
          });
        });

        // 5. IoU Non-Maximum Suppression (IoU > 0.38)
        candidateBoxes.sort((a, b) => b.score - a.score);
        const nmsBoxes = [];

        for (let i = 0; i < candidateBoxes.length; i++) {
          const b = candidateBoxes[i];
          let overlaps = false;
          for (let j = 0; j < nmsBoxes.length; j++) {
            const f = nmsBoxes[j];
            const ix1 = Math.max(b.bbox[0], f.bbox[0]);
            const iy1 = Math.max(b.bbox[1], f.bbox[1]);
            const ix2 = Math.min(b.bbox[2], f.bbox[2]);
            const iy2 = Math.min(b.bbox[3], f.bbox[3]);
            const inter = Math.max(0, ix2 - ix1) * Math.max(0, iy2 - iy1);
            const a1 = (b.bbox[2] - b.bbox[0]) * (b.bbox[3] - b.bbox[1]);
            const a2 = (f.bbox[2] - f.bbox[0]) * (f.bbox[3] - f.bbox[1]);
            const union = a1 + a2 - inter;
            if (union > 0 && inter / union > 0.38) {
              overlaps = true;
              break;
            }
          }
          if (!overlaps) {
            nmsBoxes.push(b);
            if (nmsBoxes.length >= 36) break; // Allow up to 36 dense detections!
          }
        }

        // 6. Map NMS boxes to municipal waste streams and fine-grained labels
        const detections = nmsBoxes.map((item, idx) => {
          const [x1, y1, x2, y2] = item.bbox;
          const bw = x2 - x1;
          const bh = y2 - y1;
          const { r, g, b } = item.rgb;

          let stream = 'Recyclable';
          let category = 'Recyclable / Plastic';
          let label = 'PET_bottle';
          let humanLabel = 'PET Plastic Bottle';
          let colorHex = '#2563EB';
          let disposal = 'Rinse and discard into blue recyclable bin.';

          if (g > r * 1.05 && g > b * 1.05) {
            stream = 'Organic';
            category = 'Organic / Biodegradable';
            label = 'vegetable_scrap';
            humanLabel = 'Organic Food & Vegetable Scrap';
            colorHex = '#059669';
            disposal = 'Compostable organic matter. Deposit directly into green compost bin.';
          } else if (r > 165 && g < 115 && b < 115) {
            stream = 'Hazardous';
            category = 'Hazardous / E-Waste';
            label = 'battery_ewaste';
            humanLabel = 'Hazardous Battery / E-Waste';
            colorHex = '#DC2626';
            disposal = 'Dangerous chemical / fire risk. Deposit into red hazardous container.';
          } else if (r > 180 && g > 135 && b < 100) {
            stream = 'Organic';
            category = 'Organic / Biodegradable';
            label = 'banana_peel';
            humanLabel = 'Organic Fruit Scrap';
            colorHex = '#059669';
            disposal = 'Deposit into green composting container.';
          } else if (Math.abs(r - g) < 22 && Math.abs(g - b) < 22 && (r < 95 || r > 215)) {
            if (r < 95) {
              stream = 'Residual';
              category = 'Non-Recyclable / Residual';
              label = 'foil_wrapper';
              humanLabel = 'Multilayer Packaging Foil';
              colorHex = '#D97706';
              disposal = 'Non-recyclable composite film. Deposit into municipal general waste.';
            } else {
              stream = 'Recyclable';
              category = 'Recyclable / Plastic';
              label = 'paper_waste';
              humanLabel = 'Clean Paper / Cardboard';
              colorHex = '#2563EB';
              disposal = 'Flatten and deposit into blue recycling bin.';
            }
          } else if (b > r * 1.06) {
            stream = 'Recyclable';
            category = 'Recyclable / Plastic';
            label = 'PET_bottle';
            humanLabel = 'PET Beverage Bottle';
            colorHex = '#2563EB';
            disposal = 'Empty liquid, replace cap, and place into blue recycling bin.';
          } else {
            stream = 'Recyclable';
            category = 'Recyclable / Plastic';
            label = 'aluminum_can';
            humanLabel = 'Aluminum Beverage Can';
            colorHex = '#2563EB';
            disposal = '100% infinitely recyclable metal. Deposit into blue bin.';
          }

          // Varied realistic confidence percentages based on edge sharpness
          const confVal = Math.min(0.97, Math.max(0.68, 0.72 + (item.score / 35.0) * 0.24));
          const confPct = `${Math.round(confVal * 100)}%`;

          return {
            id: `item-${idx + 1}`,
            label,
            humanLabel,
            category,
            stream,
            confidence: confVal,
            confidencePercent: confPct,
            colorHex,
            disposal_instruction: disposal,
            bbox: [x1, y1, x2, y2],
            boxNorm: {
              x: Math.round((x1 / natW) * 1000) / 10,
              y: Math.round((y1 / natH) * 1000) / 10,
              width: Math.round((bw / natW) * 1000) / 10,
              height: Math.round((bh / natH) * 1000) / 10
            },
            area_px: bw * bh
          };
        });

        return detections;
      } catch (err) {
        console.error('[EcoRoute AI] Image feature analysis error:', err);
        return [];
      }
    }

    // High-precision canvas bounding box rendering with strict bounds clamping
    function drawDetectionsOnCanvas(canvas, img, detList, highlightedId, filterStream) {
      if (!canvas || !img) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const natW = img.naturalWidth || img.width || 800;
      const natH = img.naturalHeight || img.height || 600;

      canvas.width = natW;
      canvas.height = natH;

      ctx.clearRect(0, 0, natW, natH);
      ctx.drawImage(img, 0, 0, natW, natH);

      const activeDets = (!filterStream || filterStream === 'All')
        ? detList
        : (detList || []).filter(d => d.stream === filterStream || (d.category && d.category.includes(filterStream)));

      (activeDets || []).forEach((det) => {
        let x1 = 0, y1 = 0, x2 = 0, y2 = 0;

        if (det.boxNorm) {
          x1 = (det.boxNorm.x / 100) * natW;
          y1 = (det.boxNorm.y / 100) * natH;
          x2 = x1 + (det.boxNorm.width / 100) * natW;
          y2 = y1 + (det.boxNorm.height / 100) * natH;
        } else if (det.bbox && det.bbox.length === 4) {
          x1 = det.bbox[0];
          y1 = det.bbox[1];
          x2 = det.bbox[2];
          y2 = det.bbox[3];
        } else {
          return;
        }

        x1 = Math.max(0, Math.min(natW - 4, x1));
        y1 = Math.max(0, Math.min(natH - 4, y1));
        x2 = Math.max(x1 + 4, Math.min(natW, x2));
        y2 = Math.max(y1 + 4, Math.min(natH, y2));

        const bw = x2 - x1;
        const bh = y2 - y1;

        const isHighlighted = highlightedId === det.id;
        const streamInfo = STREAMS[det.stream] || STREAMS['Recyclable'];
        const boxColor = isHighlighted ? '#F59E0B' : (det.colorHex || streamInfo.color);

        ctx.globalAlpha = highlightedId && !isHighlighted ? 0.35 : 1.0;

        ctx.strokeStyle = boxColor;
        const lineW = isHighlighted ? Math.max(4, Math.round(natW / 240)) : Math.max(2, Math.round(natW / 360));
        ctx.lineWidth = lineW;
        ctx.strokeRect(x1, y1, bw, bh);

        const cLen = Math.min(18, bw / 3, bh / 3);
        if (cLen > 3) {
          ctx.lineWidth = lineW + 2;
          ctx.beginPath();
          ctx.moveTo(x1, y1 + cLen); ctx.lineTo(x1, y1); ctx.lineTo(x1 + cLen, y1);
          ctx.moveTo(x2 - cLen, y1); ctx.lineTo(x2, y1); ctx.lineTo(x2, y1 + cLen);
          ctx.moveTo(x1, y2 - cLen); ctx.lineTo(x1, y2); ctx.lineTo(x1 + cLen, y2);
          ctx.moveTo(x2 - cLen, y2); ctx.lineTo(x2, y2); ctx.lineTo(x2, y2 - cLen);
          ctx.stroke();
        }

        const labelText = `${det.label || det.humanLabel}: ${det.confidencePercent || (Math.round((det.confidence || 0.9) * 100) + '%')}`;
        const fontSize = Math.max(11, Math.min(22, Math.round(natW / 44)));
        ctx.font = `bold ${fontSize}px Inter, -apple-system, sans-serif`;
        const tw = ctx.measureText(labelText).width;
        const th = fontSize + 8;
        const pillW = tw + 14;

        const pillY = (y1 - th - 4 >= 0) ? (y1 - th - 4) : (y1 + 4);
        const pillX = Math.max(2, Math.min(natW - pillW - 2, x1));

        ctx.fillStyle = boxColor;
        ctx.beginPath();
        if (ctx.roundRect) {
          ctx.roundRect(pillX, pillY, pillW, th, [4]);
        } else {
          ctx.rect(pillX, pillY, pillW, th);
        }
        ctx.fill();

        ctx.fillStyle = '#FFFFFF';
        ctx.textBaseline = 'middle';
        ctx.fillText(labelText, pillX + 7, pillY + (th / 2));
        ctx.globalAlpha = 1.0;
      });
    }

    function App() {
      // Navigation: 'dashboard', 'vision', 'bins', 'fleet', 'routes', 'history', 'analytics', 'reports', 'settings'
      const [currentView, setCurrentView] = useState('dashboard');
      const [isBackendLive, setIsBackendLive] = useState(true);
      const [notificationsOpen, setNotificationsOpen] = useState(false);
      const [globalSearch, setGlobalSearch] = useState('');
      const [toastMessage, setToastMessage] = useState(null);

      // Auth & Role-Based Access Control (RBAC)
      const [currentUser, setCurrentUser] = useState({
        id: 'usr-admin-01',
        email: 'admin@ecoroute.city',
        full_name: 'Chethan (CS)',
        role: 'admin',
        avatar_initials: 'CS',
        phone: '+91 98450 11223'
      });
      const [authModalOpen, setAuthModalOpen] = useState(false);
      const [loginEmail, setLoginEmail] = useState('');
      const [loginPass, setLoginPass] = useState('');

      // Database Entities State
      const [bins, setBins] = useState([]);
      const [vehicles, setVehicles] = useState([]);
      const [drivers, setDrivers] = useState([]);
      const [notifications, setNotifications] = useState([]);
      const [collectionLogs, setCollectionLogs] = useState([]);
      const [analyticsData, setAnalyticsData] = useState(null);

      // Map Layer Mode: 'satellite', 'hybrid', 'street'
      const [mapLayer, setMapLayer] = useState('hybrid');
      const [mapApiKey, setMapApiKey] = useState(localStorage.getItem('ecoroute_map_key') || '');
      const [mapProvider, setMapProvider] = useState(localStorage.getItem('ecoroute_map_provider') || 'esri');

      // Routing state
      const [routeType, setRouteType] = useState('smart'); // 'smart' or 'standard'

      // Vision Scanner state
      const [scannerMode, setScannerMode] = useState('image'); // 'image', 'video-processing', 'video-result', 'camera'
      const [currentImageSrc, setCurrentImageSrc] = useState(DEFAULT_WASTE_IMAGE_BASE64);
      const [detections, setDetections] = useState(SAMPLE_PRESETS.litter.detections);
      const [categoryCounts, setCategoryCounts] = useState(SAMPLE_PRESETS.litter.categoryCounts);
      const [highlightedItemId, setHighlightedItemId] = useState(null);
      const [selectedStreamFilter, setSelectedStreamFilter] = useState('All');
      const [videoResult, setVideoResult] = useState(null);
      const [isProcessing, setIsProcessing] = useState(false);

      // Modals State
      const [inspectedBin, setInspectedBin] = useState(null);
      const [binModalOpen, setBinModalOpen] = useState(false);
      const [binModalMode, setBinModalMode] = useState('add'); // 'add' or 'edit'
      const [binFormData, setBinFormData] = useState({
        id: '',
        name: '',
        zone: 'Indiranagar Core',
        address: '',
        lat: 12.9716,
        lng: 77.5946,
        category: 'recyclable',
        fillLevel: 25.0,
        priority: 'Normal',
        capacityKg: 100.0
      });

      const [vehicleModalOpen, setVehicleModalOpen] = useState(false);
      const [vehicleFormData, setVehicleFormData] = useState({
        name: '',
        model: 'Tata Ultra EV CleanCity',
        plate_number: '',
        status: 'Available',
        driver_id: '',
        fuel_battery_pct: 100,
        capacity_tons: 5.0,
        assigned_zone: 'Central Core'
      });

      const [driverModalOpen, setDriverModalOpen] = useState(false);
      const [driverFormData, setDriverFormData] = useState({
        name: '',
        phone: '',
        license_no: '',
        status: 'On Duty',
        rating: 4.9,
        assigned_vehicle_id: ''
      });

      // Filter states for Smart Bins
      const [binCategoryFilter, setBinCategoryFilter] = useState('All');
      const [binPriorityFilter, setBinPriorityFilter] = useState('All');
      const [binZoneFilter, setBinZoneFilter] = useState('All');

      // Fleet tab state: 'vehicles' or 'drivers'
      const [fleetTab, setFleetTab] = useState('vehicles');

      // Refs
      const dashboardMapRef = useRef(null);
      const fullMapRef = useRef(null);
      const dMapInstance = useRef(null);
      const fMapInstance = useRef(null);
      const canvasRef = useRef(null);
      const dashboardCanvasRef = useRef(null);
      const fileInputRef = useRef(null);
      const dashboardFileInputRef = useRef(null);
      const activeObjectUrlRef = useRef(null);
      const videoRef = useRef(null);
      const cameraStreamRef = useRef(null);
      const cameraIntervalRef = useRef(null);

      // Show toast helper
      const showToast = (msg) => {
        setToastMessage(msg);
        setTimeout(() => setToastMessage(null), 3500);
      };

      // Initial Data Fetching from Database
      const loadAllData = async () => {
        try {
          const [hRes, bRes, vRes, dRes, nRes, cRes, aRes] = await Promise.all([
            fetch(`${API_BASE}/health`),
            fetch(`${API_BASE}/bins`),
            fetch(`${API_BASE}/vehicles`),
            fetch(`${API_BASE}/drivers`),
            fetch(`${API_BASE}/notifications`),
            fetch(`${API_BASE}/collections/history`),
            fetch(`${API_BASE}/analytics`)
          ]);

          setIsBackendLive(hRes.ok);

          if (bRes.ok) {
            const bData = await bRes.json();
            setBins(bData);
          }
          if (vRes.ok) {
            const vData = await vRes.json();
            setVehicles(vData);
          }
          if (dRes.ok) {
            const dData = await dRes.json();
            setDrivers(dData);
          }
          if (nRes.ok) {
            const nData = await nRes.json();
            setNotifications(nData);
          }
          if (cRes.ok) {
            const cData = await cRes.json();
            setCollectionLogs(cData);
          }
          if (aRes.ok) {
            const aData = await aRes.json();
            setAnalyticsData(aData);
          }
        } catch (e) {
          setIsBackendLive(false);
        }
      };

      useEffect(() => {
        loadAllData();
        const interval = setInterval(loadAllData, 12000);
        return () => clearInterval(interval);
      }, []);

      // Check current user session on mount
      useEffect(() => {
        const checkUser = async () => {
          try {
            const res = await fetch(`${API_BASE}/auth/me`);
            if (res.ok) {
              const data = await res.json();
              if (data.user) setCurrentUser(data.user);
            }
          } catch (e) {}
        };
        checkUser();
      }, []);

      // Filtered Bins
      const fullBins = useMemo(() => bins.filter(b => (b.fillLevel !== undefined ? b.fillLevel : b.fill) >= 75), [bins]);
      const unreadAlerts = useMemo(() => notifications.filter(n => !n.is_read), [notifications]);

      // Dynamic Savings Calculations
      const stdDistance = +(3.8 * bins.length + 4.2).toFixed(1);
      const stdTime = Math.round(bins.length * 12 + 18);
      const stdFuel = +(stdDistance * 0.31).toFixed(1);
      const stdCo2 = +(stdFuel * 2.65).toFixed(1);

      const targetCount = fullBins.length > 0 ? fullBins.length : 3;
      const aiDistance = +(3.5 * targetCount + 3.4).toFixed(1);
      const aiTime = Math.round(targetCount * 12 + 12);
      const aiFuel = +(aiDistance * 0.31).toFixed(1);
      const aiCo2 = +(aiFuel * 2.65).toFixed(1);

      const distSaved = +(Math.max(0, stdDistance - aiDistance)).toFixed(1);
      const distSavedPct = stdDistance > 0 ? +((distSaved / stdDistance) * 100).toFixed(1) : 0;
      const timeSaved = Math.max(0, stdTime - aiTime);
      const timeSavedPct = stdTime > 0 ? +((timeSaved / stdTime) * 100).toFixed(1) : 0;
      const fuelSaved = +(Math.max(0, stdFuel - aiFuel)).toFixed(1);
      const co2Saved = +(Math.max(0, stdCo2 - aiCo2)).toFixed(1);

      // --- AUTH SWITCH FUNCTION ---
      const handleAuthSwitch = async (email, password) => {
        try {
          const res = await fetch(`${API_BASE}/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });
          if (res.ok) {
            const data = await res.json();
            setCurrentUser(data.user);
            localStorage.setItem('ecoroute_token', data.token);
            setAuthModalOpen(false);
            showToast(`Switched account: Signed in as ${data.user.full_name} (${data.user.role.toUpperCase()})`);
          } else {
            alert('Authentication failed: Invalid credentials.');
          }
        } catch (e) {
          alert('Backend authentication endpoint unreachable.');
        }
      };

      // --- SIMULATE SENSOR TELEMETRY ---
      const handleSimulateSensors = async () => {
        try {
          const res = await fetch(`${API_BASE}/bins/simulate`, { method: 'POST' });
          if (res.ok) {
            const data = await res.json();
            setBins(data.bins);
            showToast(`Simulated Sensor Telemetry (IoT) pushed to ${data.bins.length} bins!`);
            loadAllData();
          }
        } catch (e) {
          showToast('Failed to trigger sensor simulation.');
        }
      };

      // --- BIN CRUD OPERATIONS ---
      const handleSaveBin = async (e) => {
        e.preventDefault();
        try {
          if (binModalMode === 'add') {
            const res = await fetch(`${API_BASE}/bins`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(binFormData)
            });
            if (res.ok) {
              showToast(`Smart Bin ${binFormData.name} created!`);
              setBinModalOpen(false);
              loadAllData();
            }
          } else {
            const res = await fetch(`${API_BASE}/bins/${binFormData.id}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(binFormData)
            });
            if (res.ok) {
              showToast(`Smart Bin ${binFormData.name} updated!`);
              setBinModalOpen(false);
              loadAllData();
            }
          }
        } catch (err) {
          alert('Error saving bin details.');
        }
      };

      const handleDeleteBin = async (binId) => {
        if (currentUser.role !== 'admin') {
          alert('Admin Privileges Required: Only municipal administrators can delete smart bins.');
          return;
        }
        if (!confirm('Are you sure you want to remove this smart bin from the municipal grid?')) return;
        try {
          const res = await fetch(`${API_BASE}/bins/${binId}`, { method: 'DELETE' });
          if (res.ok) {
            showToast(`Smart Bin ${binId} removed.`);
            loadAllData();
          }
        } catch (e) {
          alert('Failed to delete bin.');
        }
      };

      // --- VEHICLE & DRIVER CRUD ---
      const handleSaveVehicle = async (e) => {
        e.preventDefault();
        try {
          const res = await fetch(`${API_BASE}/vehicles`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(vehicleFormData)
          });
          if (res.ok) {
            showToast(`Vehicle ${vehicleFormData.name} added to fleet!`);
            setVehicleModalOpen(false);
            loadAllData();
          }
        } catch (e) {
          alert('Failed to create vehicle.');
        }
      };

      const handleSaveDriver = async (e) => {
        e.preventDefault();
        try {
          const res = await fetch(`${API_BASE}/drivers`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(driverFormData)
          });
          if (res.ok) {
            showToast(`Driver ${driverFormData.name} registered!`);
            setDriverModalOpen(false);
            loadAllData();
          }
        } catch (e) {
          alert('Failed to register driver.');
        }
      };

      // --- ROUTE DISPATCH TO FLEET ---
      const handleDispatchRoute = async () => {
        try {
          const res = await fetch(`${API_BASE}/collections/dispatch`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              vehicle_code: 'TRK-01',
              driver_name: 'Suresh Gowda',
              bins_serviced_count: fullBins.length > 0 ? fullBins.length : 5,
              total_weight_tons: +(fullBins.length * 0.85 + 1.2).toFixed(1),
              distance_km: aiDistance,
              fuel_saved_liters: fuelSaved,
              co2_avoided_kg: co2Saved,
            })
          });
          if (res.ok) {
            showToast('AI Smart Route dispatched to Electric Compactor TRK-01!');
            loadAllData();
          }
        } catch (e) {
          showToast('Failed to log route dispatch.');
        }
      };

      // --- NOTIFICATIONS MANAGEMENT ---
      const handleMarkNotificationRead = async (id) => {
        try {
          await fetch(`${API_BASE}/notifications/${id}/read`, { method: 'POST' });
          loadAllData();
        } catch (e) {}
      };

      const handleClearAllNotifications = async () => {
        try {
          await fetch(`${API_BASE}/notifications/clear-all`, { method: 'POST' });
          loadAllData();
          showToast('All operational alerts marked as read.');
        } catch (e) {}
      };

      // --- MAP TILES & RENDERING ---
      const applyMapTiles = (map) => {
        if (!map) return;
        map.eachLayer((layer) => {
          if (layer instanceof L.TileLayer) map.removeLayer(layer);
        });

        if (mapLayer === 'satellite' || mapLayer === 'hybrid') {
          L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            attribution: 'Tiles &copy; Esri World Imagery'
          }).addTo(map);

          if (mapLayer === 'hybrid') {
            L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x}', {
              maxZoom: 19
            }).addTo(map);
            L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}', {
              maxZoom: 19
            }).addTo(map);
          }
        } else {
          L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            attribution: 'Tiles &copy; Esri & OpenStreetMap contributors'
          }).addTo(map);
        }
      };

      // Render Bins, Vehicles, Depot and Polyline
      const renderMapPinsAndRoutes = (map) => {
        if (!map) return;
        map.eachLayer((layer) => {
          if (layer instanceof L.Marker || layer instanceof L.Polyline) {
            map.removeLayer(layer);
          }
        });

        // 1. Depot HQ Marker
        const depotIcon = L.divIcon({
          html: `<div style="background:#0B3B24;color:white;padding:5px 10px;border-radius:10px;font-size:11px;font-weight:bold;border:2px solid #10B981;box-shadow:0 4px 10px rgba(0,0,0,0.5);white-space:nowrap;display:flex;align-items:center;gap:4px;">🏢 <span>Central Fleet Depot</span></div>`,
          iconSize: [85, 32],
          iconAnchor: [42, 32]
        });
        L.marker([CITY_DEPOT.lat, CITY_DEPOT.lng], { icon: depotIcon })
          .bindPopup(`<b>${CITY_DEPOT.name}</b><br/>${CITY_DEPOT.address}<br/><span style="color:#10B981;font-weight:bold;">Central Dispatch & Fleet Return Base</span>`)
          .addTo(map);

        // 2. Smart Bin Markers
        bins.forEach(bin => {
          const fillVal = bin.fillLevel !== undefined ? bin.fillLevel : bin.fill;
          const isCrit = fillVal >= 75;
          const isHalf = fillVal >= 40 && fillVal < 75;
          const color = isCrit ? '#DC2626' : isHalf ? '#D97706' : '#059669';

          const icon = L.divIcon({
            html: `<div style="background:${color};color:white;padding:3px 8px;border-radius:999px;font-size:11px;font-weight:900;border:2px solid white;box-shadow:0 4px 8px rgba(0,0,0,0.4);white-space:nowrap;">${Math.round(fillVal)}%</div>`,
            iconSize: [42, 28],
            iconAnchor: [21, 28]
          });
          const m = L.marker([bin.lat, bin.lng], { icon })
            .bindPopup(`
              <div style="min-width:190px;font-family:Inter,sans-serif;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                  <b>${bin.code}</b>
                  <span style="font-size:10px;font-weight:bold;padding:2px 6px;border-radius:4px;color:white;background:${color};">
                    ${bin.priority || (isCrit ? 'CRITICAL' : 'NORMAL')}
                  </span>
                </div>
                <div style="font-size:13px;font-weight:700;color:#0F172A;">${bin.name}</div>
                <div style="font-size:11px;color:#64748B;margin-bottom:6px;">${bin.address} (${bin.zone})</div>
                <div style="font-size:11px;border-top:1px solid #E2E8F0;padding-top:4px;">
                  Fill: <b>${fillVal}%</b> | Stream: <b style="text-transform:capitalize;">${bin.category}</b><br/>
                  Battery: <b>${bin.batteryLevel || bin.battery}%</b> | Last Synced: <b>${bin.lastUpdated}</b>
                </div>
              </div>
            `)
            .addTo(map);
          m.on('click', () => setInspectedBin(bin));
        });

        // 3. Interactive Fleet Vehicle Markers
        vehicles.forEach(veh => {
          const isEnRoute = veh.status === 'En Route';
          const vehColor = isEnRoute ? '#10B981' : veh.status === 'Charging' ? '#3B82F6' : '#64748B';
          const truckIcon = L.divIcon({
            html: `<div style="background:${vehColor};color:white;padding:3px 8px;border-radius:8px;font-size:11px;font-weight:bold;border:2px solid white;box-shadow:0 4px 10px rgba(0,0,0,0.5);display:flex;align-items:center;gap:4px;white-space:nowrap;" class="${isEnRoute ? 'animate-bounce' : ''}">🚚 <span>${veh.code}</span></div>`,
            iconSize: [68, 28],
            iconAnchor: [34, 28]
          });

          L.marker([veh.current_lat, veh.current_lng], { icon: truckIcon })
            .bindPopup(`
              <div style="min-width:200px;font-family:Inter,sans-serif;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                  <b>${veh.code} • ${veh.name}</b>
                  <span style="font-size:10px;font-weight:bold;padding:2px 6px;border-radius:4px;color:white;background:${vehColor};">
                    ${veh.status}
                  </span>
                </div>
                <div style="font-size:11px;color:#64748B;">${veh.model} (${veh.plate_number})</div>
                <div style="font-size:11px;border-top:1px solid #E2E8F0;padding-top:4px;margin-top:4px;">
                  Assigned Driver: <b>${veh.driver_name || 'Unassigned'}</b><br/>
                  Battery / Fuel: <b>${veh.fuel_battery_pct}%</b> | Capacity: <b>${veh.capacity_tons} Tons</b><br/>
                  Assigned Zone: <b>${veh.assigned_zone}</b>
                </div>
              </div>
            `)
            .addTo(map);
        });

        // 4. Dynamic Route Polyline
        const targetBins = routeType === 'smart' ? fullBins : bins;
        const latlngs = [
          [CITY_DEPOT.lat, CITY_DEPOT.lng],
          ...targetBins.map(b => [b.lat, b.lng]),
          [CITY_DEPOT.lat, CITY_DEPOT.lng]
        ];

        L.polyline(latlngs, {
          color: routeType === 'smart' ? '#10B981' : '#3B82F6',
          weight: routeType === 'smart' ? 5 : 4,
          opacity: 0.9,
          dashArray: routeType === 'smart' ? null : '6, 6'
        }).addTo(map);

        // 5. Fit bounds smoothly
        const allPoints = [
          [CITY_DEPOT.lat, CITY_DEPOT.lng],
          ...targetBins.map(b => [b.lat, b.lng]),
          ...vehicles.map(v => [v.current_lat, v.current_lng])
        ];
        if (allPoints.length > 1) {
          const bounds = L.latLngBounds(allPoints);
          map.fitBounds(bounds.pad(0.12), { animate: true, maxZoom: 14 });
        } else {
          map.setView([CITY_DEPOT.lat, CITY_DEPOT.lng], 12.5);
        }
      };

      // Initialize Dashboard Map once into persistent container
      useEffect(() => {
        if (!dashboardMapRef.current) return;
        if (!dMapInstance.current) {
          if (dashboardMapRef.current._leaflet_id) {
            delete dashboardMapRef.current._leaflet_id;
          }
          const map = L.map(dashboardMapRef.current, { zoomControl: false }).setView([12.9716, 77.5946], 12);
          L.control.zoom({ position: 'bottomright' }).addTo(map);
          dMapInstance.current = map;
          applyMapTiles(map);
          renderMapPinsAndRoutes(map);
        }
      }, []);

      // Initialize Route Optimizer Map once into persistent container
      useEffect(() => {
        if (!fullMapRef.current) return;
        if (!fMapInstance.current) {
          if (fullMapRef.current._leaflet_id) {
            delete fullMapRef.current._leaflet_id;
          }
          const map = L.map(fullMapRef.current).setView([12.9716, 77.5946], 12.5);
          fMapInstance.current = map;
          applyMapTiles(map);
          renderMapPinsAndRoutes(map);
        }
      }, []);

      // Decoupled Map Invalidation on view switches & resizes
      useEffect(() => {
        if (currentView === 'dashboard' && dMapInstance.current) {
          const t1 = setTimeout(() => { if (dMapInstance.current) dMapInstance.current.invalidateSize(); }, 60);
          const t2 = setTimeout(() => { if (dMapInstance.current) dMapInstance.current.invalidateSize(); }, 250);
          return () => { clearTimeout(t1); clearTimeout(t2); };
        } else if (currentView === 'routes' && fMapInstance.current) {
          const t1 = setTimeout(() => { if (fMapInstance.current) fMapInstance.current.invalidateSize(); }, 60);
          const t2 = setTimeout(() => { if (fMapInstance.current) fMapInstance.current.invalidateSize(); }, 250);
          return () => { clearTimeout(t1); clearTimeout(t2); };
        }
      }, [currentView]);

      // Window resize listener
      useEffect(() => {
        const handleResize = () => {
          if (dMapInstance.current) dMapInstance.current.invalidateSize();
          if (fMapInstance.current) fMapInstance.current.invalidateSize();
        };
        window.addEventListener('resize', handleResize);
        return () => window.removeEventListener('resize', handleResize);
      }, []);

      // Update pins and routes independently from image detection
      useEffect(() => {
        if (dMapInstance.current) {
          applyMapTiles(dMapInstance.current);
          renderMapPinsAndRoutes(dMapInstance.current);
        }
        if (fMapInstance.current) {
          applyMapTiles(fMapInstance.current);
          renderMapPinsAndRoutes(fMapInstance.current);
        }
      }, [mapLayer, bins, vehicles, routeType]);

            // --- SYNCHRONIZED CANVAS DRAWING FOR AI VISION & DASHBOARD CARD ---
      const redrawAllCanvases = useCallback(() => {
        if (!currentImageSrc) return;
        if (scannerMode === 'camera' || scannerMode === 'video-result' || scannerMode === 'video-processing') return;

        const img = new Image();
        if (currentImageSrc.startsWith('http://') || currentImageSrc.startsWith('https://')) {
          img.crossOrigin = 'anonymous';
        }

        img.onload = () => {
          if (canvasRef.current) {
            drawDetectionsOnCanvas(canvasRef.current, img, detections, highlightedItemId, selectedStreamFilter);
          }
          if (dashboardCanvasRef.current) {
            drawDetectionsOnCanvas(dashboardCanvasRef.current, img, detections, null, 'All');
          }
        };

        img.onerror = () => {
          console.warn('[EcoRoute AI] Image loading issue. Restoring embedded baseline.');
          if (currentImageSrc !== DEFAULT_WASTE_IMAGE_BASE64) {
            setCurrentImageSrc(DEFAULT_WASTE_IMAGE_BASE64);
          }
        };

        img.src = currentImageSrc;
      }, [currentImageSrc, detections, highlightedItemId, selectedStreamFilter, scannerMode]);

      useEffect(() => {
        redrawAllCanvases();
        const t1 = setTimeout(redrawAllCanvases, 50);
        const t2 = setTimeout(redrawAllCanvases, 220);
        return () => { clearTimeout(t1); clearTimeout(t2); };
      }, [redrawAllCanvases, currentView]);

      // --- FILE UPLOADER (PHOTOS & VIDEOS) ---
      const handleFileUpload = async (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;

        e.target.value = '';
        stopCamera();

        // 1. Video Processing Flow
        if (file.type.startsWith('video/') || file.name.match(/\.(mp4|mov|avi|webm)$/i)) {
          setScannerMode('video-processing');
          setIsProcessing(true);

          const formData = new FormData();
          formData.append('file', file);

          try {
            const res = await fetch(`${API_BASE}/detect/video`, {
              method: 'POST',
              body: formData
            });

            if (res.ok) {
              const data = await res.json();
              setVideoResult(data);
              setScannerMode('video-result');
              showToast(`Video processed: ${data.totalDetections || 0} waste items identified.`);
            } else {
              throw new Error('Video detection processing failed');
            }
          } catch (err) {
            alert('Video detection failed. Ensure the video file is valid.');
            setScannerMode('image');
          } finally {
            setIsProcessing(false);
          }
          return;
        }

        // 2. Image Processing Flow
        if (activeObjectUrlRef.current) {
          try { URL.revokeObjectURL(activeObjectUrlRef.current); } catch (err) {}
          activeObjectUrlRef.current = null;
        }

        const objUrl = URL.createObjectURL(file);
        activeObjectUrlRef.current = objUrl;

        setCurrentImageSrc(objUrl);
        setScannerMode('image');
        setIsProcessing(true);

        const img = new Image();
        img.src = objUrl;
        await new Promise((resolve) => {
          img.onload = resolve;
          img.onerror = resolve;
        });

        const natW = img.naturalWidth || 800;
        const natH = img.naturalHeight || 600;

        let backendSuccess = false;
        try {
          const formData = new FormData();
          formData.append('file', file);

          const res = await fetch(`${API_BASE}/detect/image`, {
            method: 'POST',
            body: formData
          });

          if (res.ok) {
            const data = await res.json();
            if (data && Array.isArray(data.detections)) {
              backendSuccess = true;
              const processedDets = data.detections.map((d, idx) => {
                let bx = 0, by = 0, bw = 100, bh = 100;
                if (d.bbox && d.bbox.length === 4) {
                  bx = d.bbox[0];
                  by = d.bbox[1];
                  bw = d.bbox[2] - d.bbox[0];
                  bh = d.bbox[3] - d.bbox[1];
                } else if (d.boxNorm) {
                  bx = (d.boxNorm.x / 100) * natW;
                  by = (d.boxNorm.y / 100) * natH;
                  bw = (d.boxNorm.width / 100) * natW;
                  bh = (d.boxNorm.height / 100) * natH;
                }
                bx = Math.max(0, Math.min(natW - 4, bx));
                by = Math.max(0, Math.min(natH - 4, by));
                bw = Math.max(4, Math.min(natW - bx, bw));
                bh = Math.max(4, Math.min(natH - by, bh));

                return {
                  ...d,
                  id: d.id || `det-${idx + 1}`,
                  bbox: [bx, by, bx + bw, by + bh],
                  boxNorm: {
                    x: Math.round((bx / natW) * 1000) / 10,
                    y: Math.round((by / natH) * 1000) / 10,
                    width: Math.round((bw / natW) * 1000) / 10,
                    height: Math.round((bh / natH) * 1000) / 10
                  },
                  area_px: Math.round(bw * bh)
                };
              });

              setDetections(processedDets);
              setCategoryCounts(data.categoryCounts || computeCategoryCounts(processedDets));
              showToast(`YOLOv8s Verified: ${processedDets.length} waste objects detected.`);
            }
          }
        } catch (err) {
          console.warn('[EcoRoute AI] Backend vision endpoint notice:', err);
        }

        // 3. Fallback: If backend is unreachable or offline, perform genuine image-feature analysis
        if (!backendSuccess) {
          const featureDets = analyzeImageFeatures(img, natW, natH);
          setDetections(featureDets);
          setCategoryCounts(computeCategoryCounts(featureDets));
          showToast(`Computer Vision Analysis: ${featureDets.length} objects identified based on visual features.`);
        }

        setIsProcessing(false);
      };

      const selectPreset = (key) => {
        stopCamera();
        setScannerMode('image');
        const p = SAMPLE_PRESETS[key];
        setCurrentImageSrc(p.image);
        setDetections(p.detections);
        setCategoryCounts(p.categoryCounts);
      };

      // Live Webcam
      const startCamera = async () => {
        try {
          const stream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'environment', width: { ideal: 640 }, height: { ideal: 480 } }
          });
          cameraStreamRef.current = stream;
          setScannerMode('camera');
          setTimeout(() => {
            if (videoRef.current) {
              videoRef.current.srcObject = stream;
              videoRef.current.play();
            }
          }, 100);
        } catch (e) {
          alert('Webcam permission denied or camera not available.');
        }
      };

      const stopCamera = () => {
        if (cameraStreamRef.current) {
          cameraStreamRef.current.getTracks().forEach(t => t.stop());
          cameraStreamRef.current = null;
        }
      };

      // Download Reports Helper
      const handleDownloadReport = (format) => {
        window.location.href = `${API_BASE}/reports/export?format=${format}`;
      };

      // Save Map Settings
      const saveMapKeySettings = async (key, provider) => {
        setMapApiKey(key);
        setMapProvider(provider);
        localStorage.setItem('ecoroute_map_key', key);
        localStorage.setItem('ecoroute_map_provider', provider);

        try {
          await fetch(`${API_BASE}/settings/map-key`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ apiKey: key, provider: provider, imageryStyle: mapLayer })
          });
        } catch (e) {}
        showToast('Map settings saved!');
      };

      // Trend Chart
      useEffect(() => {
        if (currentView !== 'dashboard') return;
        const ctx = document.getElementById('dashboardTrendChart');
        if (ctx) {
          const chart = new Chart(ctx, {
            type: 'bar',
            data: {
              labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
              datasets: [
                {
                  label: 'Collected Waste (Tons)',
                  data: [14.2, 15.6, 13.9, 16.1, 18.4, 12.0, 10.8],
                  backgroundColor: '#10B981',
                  borderRadius: 6
                },
                {
                  label: 'Fuel Saved (L)',
                  data: [7.6, 7.5, 8.4, 7.2, 7.9, 7.5, 7.2],
                  backgroundColor: '#2563EB',
                  borderRadius: 6
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: { legend: { position: 'top', labels: { font: { size: 11, family: 'Inter' } } } }
            }
          });
          return () => chart.destroy();
        }
      }, [currentView]);

      // Filtered Smart Bins for the Grid View
      const displayedBins = useMemo(() => {
        return bins.filter(b => {
          if (binCategoryFilter !== 'All' && b.category.toLowerCase() !== binCategoryFilter.toLowerCase()) return false;
          if (binPriorityFilter !== 'All') {
            const fillVal = b.fillLevel !== undefined ? b.fillLevel : b.fill;
            const p = b.priority || (fillVal >= 75 ? 'Critical' : fillVal >= 50 ? 'High' : 'Normal');
            if (p.toLowerCase() !== binPriorityFilter.toLowerCase()) return false;
          }
          if (binZoneFilter !== 'All' && b.zone !== binZoneFilter) return false;
          if (globalSearch) {
            const q = globalSearch.toLowerCase();
            return b.name.toLowerCase().includes(q) || b.code.toLowerCase().includes(q) || b.address.toLowerCase().includes(q);
          }
          return true;
        });
      }, [bins, binCategoryFilter, binPriorityFilter, binZoneFilter, globalSearch]);

      const uniqueZones = useMemo(() => Array.from(new Set(bins.map(b => b.zone))), [bins]);

      return (
        <div className="flex min-h-screen bg-[#F8FAFC]">
          {/* TOAST FEEDBACK NOTIFICATION */}
          {toastMessage && (
            <div className="fixed bottom-5 right-5 z-50 bg-[#0B3B24] text-white px-4 py-3 rounded-2xl shadow-2xl border border-emerald-500/40 flex items-center gap-2.5 text-xs font-bold animate-bounce">
              <span>🔔</span>
              <span>{toastMessage}</span>
            </div>
          )}

          {/* ================= LEFT NAVIGATION SIDEBAR ================= */}
          <aside className="w-64 bg-[#0B3B24] text-white flex flex-col justify-between shrink-0 shadow-xl border-r border-[#135D3A] sticky top-0 h-screen select-none z-30">
            <div>
              {/* Brand Header */}
              <div className="p-5 border-b border-[#135D3A]/60 flex items-center gap-3">
                <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-emerald-300 flex items-center justify-center text-forest text-xl font-black shadow-md">
                  ♻️
                </div>
                <div>
                  <h1 className="text-lg font-black tracking-tight text-white flex items-center gap-1.5">
                    EcoRoute <span className="text-emerald-400 font-extrabold text-xs px-1.5 py-0.5 rounded bg-emerald-950/80 border border-emerald-500/30">AI</span>
                  </h1>
                  <p className="text-[11px] text-emerald-200/80 font-medium tracking-wide">Urban Waste Intelligence</p>
                </div>
              </div>

              {/* Navigation Menu */}
              <nav className="p-3 space-y-1">
                {[
                  { id: 'dashboard', label: 'Dashboard', icon: '📊' },
                  { id: 'vision', label: 'AI Vision Scanner', icon: '👁️' },
                  { id: 'bins', label: 'Smart Bins Grid', icon: '🗑️' },
                  { id: 'fleet', label: 'Fleet & Drivers', icon: '🚛' },
                  { id: 'routes', label: 'Route Optimizer', icon: '🗺️' },
                  { id: 'history', label: 'Collection History', icon: '📋' },
                  { id: 'analytics', label: 'Analytics & Purity', icon: '📈' },
                  { id: 'reports', label: 'Audit Reports', icon: '📑' },
                  { id: 'settings', label: 'Settings & Map Key', icon: '⚙️' },
                ].map((item) => {
                  const isActive = currentView === item.id;
                  return (
                    <button
                      key={item.id}
                      onClick={() => {
                        stopCamera();
                        setCurrentView(item.id);
                      }}
                      className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-xs tracking-wide transition-all ${
                        isActive
                          ? 'bg-[#10B981] text-forest font-bold shadow-md shadow-emerald-950/30 translate-x-1'
                          : 'text-emerald-100/90 hover:bg-[#0E492D] hover:text-white'
                      }`}
                    >
                      <span className="text-base">{item.icon}</span>
                      <span>{item.label}</span>
                    </button>
                  );
                })}
              </nav>
            </div>

            {/* Bottom Badge */}
            <div className="p-4 border-t border-[#135D3A]/60">
              <div className="bg-[#0E492D] rounded-xl p-3 border border-emerald-500/20 text-center shadow-inner">
                <span className="text-[10px] font-extrabold uppercase tracking-widest text-emerald-300">Sustainability Mission</span>
                <p className="text-xs font-bold text-white mt-0.5">Greener City — Cleaner Tomorrow</p>
                <div className="mt-2 flex items-center justify-center gap-1.5 text-[10px] text-emerald-200">
                  <span className="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                  <span>100% Zero-Carbon Initiative</span>
                </div>
              </div>
            </div>
          </aside>

          {/* ================= MAIN CONTENT WRAPPER ================= */}
          <div className="flex-1 flex flex-col min-w-0">
            {/* TOP HEADER BAR */}
            <header className="h-16 bg-white/95 backdrop-blur-md border-b border-slate-200 px-6 flex items-center justify-between sticky top-0 z-20 shadow-xs">
              {/* Search Bar */}
              <div className="flex items-center gap-2 max-w-md w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 focus-within:ring-2 focus-within:ring-emerald-500 focus-within:bg-white transition-all">
                <span className="text-slate-400 text-sm">🔍</span>
                <input
                  type="text"
                  placeholder="Search bins, fleet vehicles, drivers, zones..."
                  value={globalSearch}
                  onChange={(e) => setGlobalSearch(e.target.value)}
                  className="bg-transparent border-none outline-hidden text-xs text-slate-800 w-full placeholder-slate-400 font-medium"
                />
              </div>

              {/* Right Controls */}
              <div className="flex items-center gap-4">
                {/* Live Connection Badge */}
                <div className={`px-2.5 py-1 rounded-full text-[11px] font-bold flex items-center gap-1.5 border ${
                  isBackendLive
                    ? 'bg-emerald-50 text-emerald-800 border-emerald-300'
                    : 'bg-amber-50 text-amber-800 border-amber-300'
                }`}>
                  <span className={`w-2 h-2 rounded-full ${isBackendLive ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500'}`}></span>
                  <span>{isBackendLive ? 'Core Live (127.0.0.1:8000)' : 'Client Standalone Mode'}</span>
                </div>

                {/* Notifications Bell */}
                <div className="relative">
                  <button
                    onClick={() => setNotificationsOpen(!notificationsOpen)}
                    className="p-2 rounded-xl border border-slate-200 hover:bg-slate-100 text-slate-600 relative transition-colors"
                  >
                    🔔
                    {unreadAlerts.length > 0 && (
                      <span className="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-red-600 text-white font-bold text-[9px] flex items-center justify-center animate-pulse">
                        {unreadAlerts.length}
                      </span>
                    )}
                  </button>

                  {/* Dropdown */}
                  {notificationsOpen && (
                    <div className="absolute right-0 mt-2 w-84 bg-white rounded-2xl shadow-2xl border border-slate-200 p-3 z-50 animate-fade-in">
                      <div className="flex items-center justify-between pb-2 border-b border-slate-100 mb-2">
                        <span className="text-xs font-bold text-slate-900">Active Operational Alerts</span>
                        <div className="flex items-center gap-2">
                          <button
                            onClick={handleClearAllNotifications}
                            className="text-[10px] text-slate-500 hover:text-emerald-700 font-bold"
                          >
                            Mark All Read
                          </button>
                          <span className="text-[10px] bg-red-100 text-red-700 px-2 py-0.5 rounded font-extrabold">{unreadAlerts.length} Unread</span>
                        </div>
                      </div>
                      <div className="space-y-1.5 max-h-64 overflow-y-auto pr-1">
                        {notifications.length === 0 ? (
                          <p className="text-xs text-slate-400 text-center py-4">No active operational alerts.</p>
                        ) : (
                          notifications.map(n => (
                            <div
                              key={n.id}
                              onClick={() => handleMarkNotificationRead(n.id)}
                              className={`p-2.5 rounded-xl border transition-all cursor-pointer ${
                                n.is_read ? 'bg-slate-50 border-slate-200 opacity-60' : n.level === 'critical' ? 'bg-red-50/80 border-red-200' : 'bg-blue-50/80 border-blue-200'
                              }`}
                            >
                              <div className="flex justify-between items-center mb-0.5">
                                <p className="font-bold text-xs text-slate-900">{n.title}</p>
                                <span className="text-[9px] font-semibold text-slate-400">{n.timestamp}</span>
                              </div>
                              <p className="text-[11px] text-slate-600 leading-tight">{n.message}</p>
                            </div>
                          ))
                        )}
                      </div>
                    </div>
                  )}
                </div>

                {/* Profile & Role Badge */}
                <div
                  onClick={() => setAuthModalOpen(true)}
                  className="flex items-center gap-2.5 pl-2 border-l border-slate-200 cursor-pointer hover:opacity-85 transition-opacity"
                  title="Click to switch between Admin and Operator roles"
                >
                  <div className="w-9 h-9 rounded-full bg-gradient-to-tr from-[#0B3B24] to-[#10B981] text-white font-black text-xs flex items-center justify-center shadow-sm">
                    {currentUser.avatar_initials || 'CS'}
                  </div>
                  <div className="hidden sm:block text-left leading-tight">
                    <div className="flex items-center gap-1.5">
                      <p className="text-xs font-bold text-slate-900">{currentUser.full_name}</p>
                      <span className={`px-1.5 py-0.2 rounded text-[9px] font-black uppercase text-white ${
                        currentUser.role === 'admin' ? 'bg-emerald-700' : 'bg-blue-700'
                      }`}>
                        {currentUser.role}
                      </span>
                    </div>
                    <span className="text-[10px] font-semibold text-slate-500">Click to switch role ▾</span>
                  </div>
                </div>
              </div>
            </header>

            {/* VIEW CONTAINER */}
            <main className="p-6 flex-1 space-y-6">

              {/* ======================================================== */}
              {/* 1. DASHBOARD VIEW */}
              {/* ======================================================== */}
              <div className={`space-y-6 ${currentView === 'dashboard' ? '' : 'hidden'}`}>
                  {/* Greeting Header */}
                  <div className="bg-gradient-to-r from-[#0B3B24] to-[#135D3A] rounded-2xl p-6 text-white shadow-lg flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                    <div>
                      <div className="flex items-center gap-2 mb-1">
                        <span className="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-emerald-400 text-forest shadow-xs">
                          Reduce • Recycle • Sustain
                        </span>
                        <span className="text-xs text-emerald-200">Municipal Grid: Bengaluru, India</span>
                      </div>
                      <h2 className="text-2xl font-black tracking-tight">Welcome, {currentUser.full_name}!</h2>
                      <p className="text-xs sm:text-sm text-emerald-100/90 mt-0.5">
                        City sanitation control center: real-time ultrasonic bin telemetry, live vehicle tracking, and automated route optimization.
                      </p>
                    </div>

                    <div className="flex items-center gap-2 self-start md:self-auto flex-wrap">
                      <button
                        onClick={handleSimulateSensors}
                        title="Simulated sensor telemetry changes across all 12 smart bins"
                        className="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs border border-white/20 backdrop-blur-md transition-all flex items-center gap-1.5"
                      >
                        ⚡ Simulate Telemetry (IoT)
                      </button>
                      <button
                        onClick={() => setCurrentView('vision')}
                        className="px-4 py-2 rounded-xl bg-[#10B981] hover:bg-[#34D399] text-forest font-black text-xs shadow-md transition-all flex items-center gap-1.5"
                      >
                        📷 Scan Waste Item
                      </button>
                    </div>
                  </div>

                  {/* 4 Dynamic KPI Cards */}
                  <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                      <div className="flex items-center justify-between text-xs text-slate-500 font-medium mb-1">
                        <span>Segregation Rate</span>
                        <span className="p-1.5 bg-blue-50 text-blue-600 rounded-lg text-sm">♻️</span>
                      </div>
                      <p className="text-3xl font-black text-slate-900">{analyticsData?.summary?.segregationRatePercent || 96.4}%</p>
                      <span className="text-xs font-bold text-emerald-600 mt-1 block">↑ +3.2% vs last month</span>
                    </div>

                    <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                      <div className="flex items-center justify-between text-xs text-slate-500 font-medium mb-1">
                        <span>Bins Monitored</span>
                        <span className="p-1.5 bg-emerald-50 text-emerald-600 rounded-lg text-sm">🗑️</span>
                      </div>
                      <p className="text-3xl font-black text-slate-900">{bins.length} Active</p>
                      <span className="text-xs font-bold text-red-600 mt-1 block">{fullBins.length} bins require pickup (≥75%)</span>
                    </div>

                    <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                      <div className="flex items-center justify-between text-xs text-slate-500 font-medium mb-1">
                        <span>Fleet Vehicles</span>
                        <span className="p-1.5 bg-amber-50 text-amber-600 rounded-lg text-sm">🚚</span>
                      </div>
                      <p className="text-3xl font-black text-slate-900">{vehicles.length} Trucks</p>
                      <span className="text-xs font-bold text-blue-600 mt-1 block">{vehicles.filter(v => v.status === 'En Route').length} En Route</span>
                    </div>

                    <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                      <div className="flex items-center justify-between text-xs text-slate-500 font-medium mb-1">
                        <span>CO₂ Abated</span>
                        <span className="p-1.5 bg-emerald-50 text-emerald-600 rounded-lg text-sm">🌱</span>
                      </div>
                      <p className="text-3xl font-black text-emerald-700">{analyticsData?.summary?.co2SavedTotalKg || 1420.5} kg</p>
                      <span className="text-xs font-bold text-emerald-600 mt-1 block">Equiv. to {analyticsData?.summary?.treesEquivalent || 68} trees saved</span>
                    </div>
                  </div>

                  {/* 2-Column: City Map Widget & AI Waste Detection Preview */}
                  <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    {/* Left: City Operations Map */}
                    <div className="lg:col-span-7 bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex flex-col">
                      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3 pb-2 border-b border-slate-100">
                        <div>
                          <span className="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700">Real-Time City Operations</span>
                          <h3 className="text-base font-bold text-slate-900">Live Smart Bins & Fleet Vehicles Map</h3>
                        </div>

                        <div className="flex items-center gap-1.5">
                          <div className="bg-slate-100 p-0.5 rounded-lg flex text-[11px] font-bold">
                            <button onClick={() => setMapLayer('satellite')} className={`px-2 py-1 rounded ${mapLayer === 'satellite' ? 'bg-white shadow text-slate-900' : 'text-slate-600'}`}>Satellite</button>
                            <button onClick={() => setMapLayer('hybrid')} className={`px-2 py-1 rounded ${mapLayer === 'hybrid' ? 'bg-white shadow text-slate-900' : 'text-slate-600'}`}>Hybrid</button>
                            <button onClick={() => setMapLayer('street')} className={`px-2 py-1 rounded ${mapLayer === 'street' ? 'bg-white shadow text-slate-900' : 'text-slate-600'}`}>Street</button>
                          </div>
                          <button
                            onClick={() => setCurrentView('routes')}
                            className="p-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-xs font-bold text-emerald-700 flex items-center gap-1"
                          >
                            <span>Optimize Path</span> →
                          </button>
                        </div>
                      </div>

                      {/* Map Container */}
                      <div ref={dashboardMapRef} id="dashboard-map-container" style={{ width: "100%", height: "320px", minHeight: "320px", position: "relative" }} className="rounded-xl overflow-hidden border border-slate-200 mb-3 z-0"></div>

                      {/* Legend */}
                      <div className="flex flex-wrap items-center justify-between text-xs text-slate-600 pt-1">
                        <div className="flex items-center gap-3">
                          <span className="flex items-center gap-1"><span className="w-2.5 h-2.5 rounded-full bg-emerald-600"></span> Normal</span>
                          <span className="flex items-center gap-1"><span className="w-2.5 h-2.5 rounded-full bg-amber-500"></span> High</span>
                          <span className="flex items-center gap-1"><span className="w-2.5 h-2.5 rounded-full bg-red-600 animate-pulse"></span> Critical (≥75%)</span>
                          <span className="flex items-center gap-1"><span className="w-2.5 h-2.5 rounded-full bg-[#10B981]"></span> 🚚 En Route Truck</span>
                        </div>
                        <span className="font-semibold text-emerald-700">{distSavedPct}% Distance Cut via AI</span>
                      </div>
                    </div>

                    {/* Right: AI Waste Detection Preview */}
                    <div className="lg:col-span-5 bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex flex-col justify-between">
                      <div>
                        <div className="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
                          <div>
                            <span className="text-[10px] font-extrabold uppercase tracking-wider text-blue-700">YOLOv8s Multi-Object Detection</span>
                            <h3 className="text-base font-bold text-slate-900">Latest Waste Inspection</h3>
                          </div>
                          <div className="flex items-center gap-2">
                            <label className="text-xs font-bold text-emerald-700 hover:text-emerald-900 flex items-center gap-1 cursor-pointer bg-emerald-50 hover:bg-emerald-100 px-2.5 py-1 rounded-lg border border-emerald-200 transition-colors">
                              <span>📷 Upload Image</span>
                              <input
                                ref={dashboardFileInputRef}
                                type="file"
                                accept="image/*"
                                className="hidden"
                                onChange={handleFileUpload}
                              />
                            </label>
                            <button
                              onClick={() => setCurrentView('vision')}
                              className="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1"
                            >
                              Scanner →
                            </button>
                          </div>
                        </div>

                        <div className="relative aspect-video rounded-xl overflow-hidden bg-slate-900 border border-slate-700/50 mb-3 flex items-center justify-center">
                          <canvas ref={dashboardCanvasRef} className="w-full h-full object-contain block" style={{ maxWidth: "100%", maxHeight: "100%", display: "block" }} />
                          <div className="absolute top-2 left-2 bg-[#0B3B24] text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-500/40">
                            {detections.length} Objects Detected
                          </div>
                          <div className="absolute bottom-2 right-2 bg-black/70 backdrop-blur-xs text-white text-[9px] font-bold px-2 py-0.5 rounded-full">
                            🛡️ Human Exclusion Active
                          </div>
                        </div>

                        <div className="space-y-2 mb-3">
                          <div className="p-3 rounded-xl bg-blue-50 border border-blue-200">
                            <div className="flex items-center justify-between text-xs">
                              <span className="font-bold text-blue-900">{detections[0]?.humanLabel || 'PET Plastic Bottle'}</span>
                              <span className="bg-blue-600 text-white font-extrabold px-2 py-0.5 rounded text-[10px]">{detections[0]?.confidencePercent || '98%'}</span>
                            </div>
                            <p className="text-[11px] text-blue-800 mt-1 font-medium">{detections[0]?.disposal_instruction || 'Empty liquid and deposit into blue recyclable bin.'}</p>
                          </div>
                        </div>
                      </div>

                      <button
                        onClick={() => setCurrentView('vision')}
                        className="w-full py-2.5 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-bold text-xs flex items-center justify-center gap-2 shadow"
                      >
                        <span>Scan Photos & Videos</span> →
                      </button>
                    </div>
                  </div>

                  {/* Trend Chart & Sustainability Impact */}
                  <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <div className="lg:col-span-8 bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
                      <div className="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
                        <div>
                          <span className="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Historical Benchmarks</span>
                          <h3 className="text-base font-bold text-slate-900">Collection Volume & Fuel Savings Trend</h3>
                        </div>
                        <span className="text-xs bg-emerald-50 text-emerald-800 border border-emerald-200 px-2.5 py-0.5 rounded-lg font-bold">Past 7 Days</span>
                      </div>
                      <div className="h-64 w-full">
                        <canvas id="dashboardTrendChart"></canvas>
                      </div>
                    </div>

                    <div className="lg:col-span-4 bg-gradient-to-br from-emerald-900 to-[#0B3B24] rounded-2xl p-5 text-white shadow-sm flex flex-col justify-between">
                      <div>
                        <span className="text-[10px] font-extrabold uppercase tracking-widest text-emerald-300">Environmental Scorecard</span>
                        <h3 className="text-lg font-black text-white mt-1">Sustainability Impact</h3>
                        <p className="text-xs text-emerald-100/80 mt-1">Direct environmental benefits calculated via Google OR-Tools dynamic route calculations.</p>
                        
                        <div className="space-y-3 mt-4">
                          <div className="bg-white/10 rounded-xl p-3 border border-white/10">
                            <span className="text-[11px] text-emerald-200">Diesel Fuel Saved</span>
                            <p className="text-2xl font-black text-white">{analyticsData?.summary?.fuelSavedLiters || 148.5} Liters</p>
                            <span className="text-[10px] text-emerald-300">50.2% reduction in municipal fuel burn</span>
                          </div>
                          <div className="bg-white/10 rounded-xl p-3 border border-white/10">
                            <span className="text-[11px] text-emerald-200">Equivalent Trees Planted</span>
                            <p className="text-2xl font-black text-emerald-300">{analyticsData?.summary?.treesEquivalent || 68} Mature Trees</p>
                            <span className="text-[10px] text-emerald-200">Net CO2 sequestration factor</span>
                          </div>
                        </div>
                      </div>

                      <button
                        onClick={() => handleDownloadReport('csv')}
                        className="w-full mt-4 py-2.5 rounded-xl bg-[#10B981] hover:bg-[#34D399] text-forest font-black text-xs shadow-md transition-all flex items-center justify-center gap-1.5"
                      >
                        📥 Download Audit Report (CSV)
                      </button>
                    </div>
                  </div>
                </div>

              {/* ======================================================== */}
              {/* 2. AI VISION SCANNER VIEW */}
              {/* ======================================================== */}
              <div className={`space-y-6 ${currentView === 'vision' ? '' : 'hidden'}`}>
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                    <div>
                      <span className="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700">Module 1: Computer Vision</span>
                      <h2 className="text-xl font-black text-slate-900">YOLOv8s Multi-Item Waste Detection</h2>
                      <p className="text-xs text-slate-500">Detects bottles, cans, lids, food waste, and electronics. Humans and vehicles are strictly excluded.</p>
                    </div>

                    <div className="flex items-center gap-2">
                      <button onClick={startCamera} className="px-3.5 py-2 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-bold text-xs flex items-center gap-1.5 shadow">
                        📷 Live Webcam
                      </button>
                      <label className="px-3.5 py-2 rounded-xl bg-[#10B981] hover:bg-[#34D399] text-forest font-black text-xs flex items-center gap-1.5 cursor-pointer shadow">
                        📁 Upload Photo / Video
                        <input
                          ref={fileInputRef}
                          type="file"
                          accept="image/*,video/*"
                          className="hidden"
                          onChange={handleFileUpload}
                        />
                      </label>
                    </div>
                  </div>

                  {/* 3 Clickable Presets */}
                  <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <span className="text-xs font-bold text-slate-700 uppercase tracking-wide">Test 1-Click Multi-Item Datasets:</span>
                    <div className="grid grid-cols-3 gap-2 flex-1 max-w-xl">
                      <button onClick={() => selectPreset('litter')} className="p-2 rounded-xl border border-blue-200 hover:border-blue-400 bg-blue-50/50 text-xs font-bold text-blue-900 text-center">
                        🥤 Street Litter (5 items)
                      </button>
                      <button onClick={() => selectPreset('market')} className="p-2 rounded-xl border border-emerald-200 hover:border-emerald-400 bg-emerald-50/50 text-xs font-bold text-emerald-900 text-center">
                        🍌 Market Organic (4 items)
                      </button>
                      <button onClick={() => selectPreset('electronic')} className="p-2 rounded-xl border border-red-200 hover:border-red-400 bg-red-50/50 text-xs font-bold text-red-900 text-center">
                        🔋 E-Waste Cells (3 items)
                      </button>
                    </div>
                  </div>

                  {/* Stream Filter Pills */}
                  <div className="flex items-center gap-2 flex-wrap text-xs">
                    <span className="font-bold text-slate-500 uppercase text-[10px]">Filter Streams:</span>
                    {['All', 'Recyclable', 'Organic', 'Hazardous', 'Residual'].map(filter => (
                      <button
                        key={filter}
                        onClick={() => setSelectedStreamFilter(filter)}
                        className={`px-3 py-1 rounded-full font-bold transition-all ${
                          selectedStreamFilter === filter
                            ? 'bg-[#0B3B24] text-white shadow'
                            : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                        }`}
                      >
                        {filter} {filter !== 'All' ? `(${categoryCounts[filter === 'Recyclable' ? 'Recyclable / Plastic' : filter === 'Organic' ? 'Organic / Biodegradable' : filter === 'Hazardous' ? 'Hazardous / E-Waste' : 'Non-Recyclable / Residual'] || 0})` : `(${detections.length})`}
                      </button>
                    ))}
                  </div>

                  {/* 2-Column: Canvas & Inspection Table */}
                  <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <div className="lg:col-span-7 bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex flex-col justify-between">
                      <div className="relative aspect-video rounded-xl bg-slate-900 overflow-hidden border border-slate-700/50 flex items-center justify-center shadow-inner">
                        {scannerMode === 'camera' ? (
                          <div className="w-full h-full relative">
                            <video ref={videoRef} autoPlay playsInline muted className="w-full h-full object-cover" />
                            <div className="absolute top-3 left-3 bg-[#0B3B24] text-white text-[11px] font-bold px-3 py-1 rounded-full flex items-center gap-1.5 border border-emerald-400 animate-pulse">
                              <span className="w-2 h-2 rounded-full bg-emerald-400"></span>
                              WEBCAM ACTIVE — REAL-TIME INFERENCE
                            </div>
                          </div>
                        ) : scannerMode === 'video-result' && videoResult ? (
                          <video src={videoResult.videoUrl} controls autoPlay loop className="w-full h-full object-contain" />
                        ) : scannerMode === 'video-processing' ? (
                          <div className="text-center p-6 text-white space-y-3">
                            <div className="w-10 h-10 border-4 border-emerald-400 border-t-transparent rounded-full animate-spin mx-auto"></div>
                            <p className="font-bold text-sm">Processing Video via OpenCV & YOLOv8s...</p>
                            <p className="text-xs text-slate-400">Filtering non-waste objects and rendering bounding boxes.</p>
                          </div>
                        ) : (
                          <canvas ref={canvasRef} className="w-full h-full object-contain block" style={{ maxWidth: "100%", maxHeight: "100%", display: "block" }} />
                        )}

                        {isProcessing && scannerMode !== 'video-processing' && (
                          <div className="absolute inset-0 bg-black/50 backdrop-blur-xs flex items-center justify-center">
                            <div className="text-white text-center font-bold text-xs space-y-2">
                              <div className="w-8 h-8 border-3 border-emerald-400 border-t-transparent rounded-full animate-spin mx-auto"></div>
                              <span>Running YOLOv8s Multi-Scale Detection...</span>
                            </div>
                          </div>
                        )}
                      </div>

                      {/* Stream Breakdown Counters */}
                      <div className="grid grid-cols-4 gap-2 pt-3 border-t border-slate-100 mt-3 text-center">
                        <div className="p-2.5 rounded-xl bg-blue-50 border border-blue-200 text-center">
                          <span className="text-[10px] uppercase font-bold text-blue-700">Recyclable</span>
                          <p className="text-lg font-black text-blue-900">{categoryCounts['Recyclable / Plastic'] || 0}</p>
                        </div>
                        <div className="p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-center">
                          <span className="text-[10px] uppercase font-bold text-emerald-700">Organic</span>
                          <p className="text-lg font-black text-emerald-900">{categoryCounts['Organic / Biodegradable'] || 0}</p>
                        </div>
                        <div className="p-2.5 rounded-xl bg-red-50 border border-red-200 text-center">
                          <span className="text-[10px] uppercase font-bold text-red-700">Hazardous</span>
                          <p className="text-lg font-black text-red-900">{categoryCounts['Hazardous / E-Waste'] || 0}</p>
                        </div>
                        <div className="p-2.5 rounded-xl bg-amber-50 border border-amber-200 text-center">
                          <span className="text-[10px] uppercase font-bold text-amber-700">Residual</span>
                          <p className="text-lg font-black text-amber-900">{categoryCounts['Non-Recyclable / Residual'] || 0}</p>
                        </div>
                      </div>
                    </div>

                    {/* Right: Inspection List */}
                    <div className="lg:col-span-5 bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex flex-col justify-between">
                      <div>
                        <div className="flex items-center justify-between pb-2 border-b border-slate-100 mb-3">
                          <div>
                            <span className="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Cross-Inspection Table</span>
                            <h3 className="text-base font-bold text-slate-900">
                              {scannerMode === 'video-result' ? 'Video Detected Frequency' : `Detected Items (${detections.length})`}
                            </h3>
                          </div>
                          <span className="text-[11px] text-slate-400">Hover item to highlight</span>
                        </div>

                        <div className="space-y-2 max-h-[460px] overflow-y-auto pr-1">
                          {scannerMode === 'video-result' && videoResult ? (
                            videoResult.uniqueWasteItems && videoResult.uniqueWasteItems.map((u, i) => (
                              <div key={i} className="p-3 rounded-xl border border-slate-200 bg-slate-50 flex items-center justify-between text-xs">
                                <div>
                                  <p className="font-bold text-slate-900">{u.item}</p>
                                  <span className="text-[10px] font-semibold text-slate-500">{u.category}</span>
                                </div>
                                <span className="px-2.5 py-1 rounded bg-[#0B3B24] text-emerald-300 font-black text-xs">
                                  {u.count}x Detected
                                </span>
                              </div>
                            ))
                          ) : detections.length === 0 ? (
                            <div className="p-6 text-center rounded-xl border border-dashed border-slate-300 bg-slate-50 my-auto">
                              <div className="w-12 h-12 mx-auto mb-2 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold text-xl">
                                ✓
                              </div>
                              <p className="text-xs font-bold text-slate-800">No Waste Detected</p>
                              <p className="text-[11px] text-slate-500 mt-1 leading-relaxed">
                                Zero municipal waste items identified. Human beings, vehicles, animals, and background surroundings are strictly excluded from waste sorting.
                              </p>
                              <span className="inline-block mt-3 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-[10px] font-bold text-emerald-800">
                                🛡️ Human & Non-Waste Filter Active
                              </span>
                            </div>
                          ) : (
                            detections.map((det) => {
                              const isH = highlightedItemId === det.id;
                              const stream = STREAMS[det.stream] || STREAMS['Recyclable'];
                              return (
                                <div
                                  key={det.id}
                                  onMouseEnter={() => setHighlightedItemId(det.id)}
                                  onMouseLeave={() => setHighlightedItemId(null)}
                                  onClick={() => setHighlightedItemId(isH ? null : det.id)}
                                  className={`p-3 rounded-xl border transition-all cursor-pointer ${
                                    isH
                                      ? 'border-amber-400 bg-amber-50 shadow-md ring-2 ring-amber-300'
                                      : `${stream.lightBg} hover:border-slate-400`
                                  }`}
                                >
                                  <div className="flex items-center justify-between mb-1">
                                    <span className="font-black text-xs text-slate-900">{det.humanLabel || det.label}</span>
                                    <span className={`px-2 py-0.5 rounded text-[10px] font-extrabold text-white ${stream.bg}`}>
                                      {det.confidencePercent}
                                    </span>
                                  </div>
                                  <p className="text-[11px] text-slate-700 leading-tight">👉 {det.disposal_instruction}</p>
                                  <div className="flex justify-between items-center text-[10px] text-slate-500 mt-1.5 pt-1 border-t border-slate-200/60 font-mono">
                                    <span>Stream: {det.stream}</span>
                                    <span>Area: {det.area_px ? `${det.area_px} px²` : 'N/A'}</span>
                                  </div>
                                </div>
                              );
                            })
                          )}
                        </div>
                      </div>

                      <div className="pt-3 border-t border-slate-100 text-center text-xs text-slate-500">
                        YOLOv8s + SAHI Overlapping Tiled Inference
                      </div>
                    </div>
                  </div>
                </div>

              {/* ======================================================== */}
              {/* 3. SMART BINS GRID VIEW */}
              {/* ======================================================== */}
              <div className={`space-y-6 ${currentView === 'bins' ? '' : 'hidden'}`}>
                  {/* Top Bar with Add Bin & Simulate */}
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                    <div>
                      <span className="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700">Module 2: IoT Telemetry</span>
                      <h2 className="text-xl font-black text-slate-900">Smart Bins Monitoring Network</h2>
                      <p className="text-xs text-slate-500">Ultrasonic telemetry, waste categories, and pickup priorities across Bengaluru.</p>
                    </div>

                    <div className="flex items-center gap-2 flex-wrap">
                      <button
                        onClick={handleSimulateSensors}
                        className="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs flex items-center gap-1.5 border border-slate-200 shadow-xs"
                      >
                        ⚡ Simulate Telemetry (IoT)
                      </button>
                      <button
                        onClick={() => {
                          setBinModalMode('add');
                          setBinFormData({
                            name: '',
                            zone: 'Indiranagar Core',
                            address: '',
                            lat: 12.9716,
                            lng: 77.5946,
                            category: 'recyclable',
                            fillLevel: 20.0,
                            priority: 'Normal',
                            capacityKg: 100.0
                          });
                          setBinModalOpen(true);
                        }}
                        className="px-4 py-2 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-bold text-xs flex items-center gap-1.5 shadow"
                      >
                        ➕ Add Smart Bin
                      </button>
                    </div>
                  </div>

                  {/* Filter Toolbar */}
                  <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex flex-wrap items-center justify-between gap-3">
                    <div className="flex items-center gap-2 flex-wrap text-xs">
                      <span className="font-bold text-slate-500 uppercase text-[10px]">Filter Category:</span>
                      {['All', 'recyclable', 'organic', 'hazardous', 'general'].map(cat => (
                        <button
                          key={cat}
                          onClick={() => setBinCategoryFilter(cat)}
                          className={`px-3 py-1 rounded-full font-bold capitalize transition-all ${
                            binCategoryFilter === cat ? 'bg-[#0B3B24] text-white shadow' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                          }`}
                        >
                          {cat}
                        </button>
                      ))}
                    </div>

                    <div className="flex items-center gap-2 text-xs">
                      <span className="font-bold text-slate-500 uppercase text-[10px]">Priority:</span>
                      {['All', 'Critical', 'High', 'Normal'].map(p => (
                        <button
                          key={p}
                          onClick={() => setBinPriorityFilter(p)}
                          className={`px-3 py-1 rounded-full font-bold transition-all ${
                            binPriorityFilter === p ? 'bg-emerald-700 text-white shadow' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                          }`}
                        >
                          {p}
                        </button>
                      ))}
                    </div>
                  </div>

                  {/* Smart Bins Grid */}
                  <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    {displayedBins.map(bin => {
                      const fillVal = bin.fillLevel !== undefined ? bin.fillLevel : bin.fill;
                      const isCritical = fillVal >= 75;
                      const isHalf = fillVal >= 40 && fillVal < 75;
                      const color = isCritical ? '#DC2626' : isHalf ? '#D97706' : '#059669';

                      return (
                        <div
                          key={bin.id}
                          className={`bg-white rounded-2xl p-4 border transition-all hover:shadow-md flex flex-col justify-between ${
                            isCritical ? 'border-red-300 ring-2 ring-red-100' : 'border-slate-200'
                          }`}
                        >
                          <div>
                            <div className="flex items-center justify-between mb-2">
                              <span className="font-mono text-xs font-black text-slate-800">{bin.code}</span>
                              <div className="flex items-center gap-1.5">
                                <span className={`text-[10px] font-extrabold px-2 py-0.5 rounded text-white ${
                                  bin.priority === 'Critical' || isCritical ? 'bg-red-600' : bin.priority === 'High' || isHalf ? 'bg-amber-600' : 'bg-emerald-600'
                                }`}>
                                  {bin.priority || (isCritical ? 'Critical' : 'Normal')}
                                </span>
                                <span className={`text-[10px] font-black px-2 py-0.5 rounded text-white ${
                                  isCritical ? 'bg-red-700' : isHalf ? 'bg-amber-700' : 'bg-emerald-700'
                                }`}>
                                  {Math.round(fillVal)}%
                                </span>
                              </div>
                            </div>

                            <h4 className="font-bold text-sm text-slate-900 line-clamp-1">{bin.name}</h4>
                            <p className="text-xs text-slate-500 line-clamp-1 mb-3">{bin.address} ({bin.zone})</p>

                            {/* Progress Gauge */}
                            <div className="w-full bg-slate-100 h-2 rounded-full overflow-hidden mb-2">
                              <div className="h-full rounded-full transition-all duration-500" style={{ width: `${fillVal}%`, backgroundColor: color }}></div>
                            </div>

                            <div className="flex items-center justify-between text-[11px] text-slate-500 pt-1 border-t border-slate-100">
                              <span className="capitalize">Stream: <b>{bin.category}</b></span>
                              <span>Battery: <b>{bin.batteryLevel || bin.battery}%</b></span>
                            </div>
                          </div>

                          {/* Quick Action Buttons */}
                          <div className="flex items-center gap-2 pt-3 border-t border-slate-100 mt-3">
                            <button
                              onClick={() => setInspectedBin(bin)}
                              className="flex-1 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-[11px] font-bold"
                            >
                              Inspect
                            </button>
                            <button
                              onClick={() => {
                                setBinModalMode('edit');
                                setBinFormData({
                                  id: bin.id,
                                  name: bin.name,
                                  zone: bin.zone,
                                  address: bin.address,
                                  lat: bin.lat,
                                  lng: bin.lng,
                                  category: bin.category,
                                  fillLevel: fillVal,
                                  priority: bin.priority || 'Normal',
                                  capacityKg: bin.capacityKg || 100
                                });
                                setBinModalOpen(true);
                              }}
                              className="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold"
                              title="Edit Bin"
                            >
                              ✏️
                            </button>
                            {currentUser.role === 'admin' && (
                              <button
                                onClick={() => handleDeleteBin(bin.id)}
                                className="p-1.5 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 text-xs font-bold"
                                title="Delete Bin (Admin)"
                              >
                                🗑️
                              </button>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>

              {/* ======================================================== */}
              {/* 4. FLEET & DRIVERS MANAGEMENT VIEW (NEW) */}
              {/* ======================================================== */}
              <div className={`space-y-6 ${currentView === 'fleet' ? '' : 'hidden'}`}>
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                    <div>
                      <span className="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700">Module 4: Fleet Operations</span>
                      <h2 className="text-xl font-black text-slate-900">Vehicle & Driver Management</h2>
                      <p className="text-xs text-slate-500">Manage collection trucks, battery levels, driver schedules, and real-time assignments.</p>
                    </div>

                    <div className="flex items-center gap-2">
                      <div className="bg-slate-100 p-1 rounded-xl flex text-xs font-bold">
                        <button
                          onClick={() => setFleetTab('vehicles')}
                          className={`px-3 py-1.5 rounded-lg transition-all ${
                            fleetTab === 'vehicles' ? 'bg-[#0B3B24] text-white shadow' : 'text-slate-600'
                          }`}
                        >
                          🚚 Municipal Trucks ({vehicles.length})
                        </button>
                        <button
                          onClick={() => setFleetTab('drivers')}
                          className={`px-3 py-1.5 rounded-lg transition-all ${
                            fleetTab === 'drivers' ? 'bg-[#0B3B24] text-white shadow' : 'text-slate-600'
                          }`}
                        >
                          👤 Drivers ({drivers.length})
                        </button>
                      </div>

                      {currentUser.role === 'admin' && (
                        fleetTab === 'vehicles' ? (
                          <button
                            onClick={() => setVehicleModalOpen(true)}
                            className="px-4 py-2 rounded-xl bg-[#10B981] hover:bg-[#34D399] text-forest font-black text-xs shadow flex items-center gap-1.5"
                          >
                            ➕ Add Vehicle
                          </button>
                        ) : (
                          <button
                            onClick={() => setDriverModalOpen(true)}
                            className="px-4 py-2 rounded-xl bg-[#10B981] hover:bg-[#34D399] text-forest font-black text-xs shadow flex items-center gap-1.5"
                          >
                            ➕ Add Driver
                          </button>
                        )
                      )}
                    </div>
                  </div>

                  {/* Vehicles Grid */}
                  {fleetTab === 'vehicles' && (
                    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                      {vehicles.map(veh => {
                        const isEnRoute = veh.status === 'En Route';
                        const isCharging = veh.status === 'Charging';
                        const statusBg = isEnRoute ? 'bg-emerald-600' : isCharging ? 'bg-blue-600' : 'bg-slate-600';

                        return (
                          <div key={veh.id} className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                            <div>
                              <div className="flex items-center justify-between mb-2">
                                <span className="font-mono text-xs font-black text-slate-800">{veh.code}</span>
                                <span className={`text-[10px] font-extrabold px-2.5 py-0.5 rounded text-white ${statusBg}`}>
                                  {veh.status}
                                </span>
                              </div>

                              <h4 className="font-bold text-sm text-slate-900">{veh.name}</h4>
                              <p className="text-xs text-slate-500 mb-3">{veh.model} ({veh.plate_number})</p>

                              <div className="space-y-2 text-xs border-y border-slate-100 py-3 mb-3">
                                <div className="flex justify-between">
                                  <span className="text-slate-500">Assigned Driver:</span>
                                  <span className="font-bold text-slate-800">{veh.driver_name || 'Unassigned'}</span>
                                </div>
                                <div className="flex justify-between">
                                  <span className="text-slate-500">Payload Capacity:</span>
                                  <span className="font-bold text-slate-800">{veh.capacity_tons} Tons</span>
                                </div>
                                <div className="flex justify-between">
                                  <span className="text-slate-500">Assigned Zone:</span>
                                  <span className="font-bold text-slate-800">{veh.assigned_zone}</span>
                                </div>
                              </div>

                              {/* Battery / Fuel Gauge */}
                              <div className="mb-2">
                                <div className="flex justify-between text-[11px] font-semibold text-slate-600 mb-1">
                                  <span>Battery / Fuel Gauge</span>
                                  <span className="font-bold">{veh.fuel_battery_pct}%</span>
                                </div>
                                <div className="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                                  <div
                                    className={`h-full rounded-full ${
                                      veh.fuel_battery_pct < 40 ? 'bg-amber-500' : 'bg-emerald-500'
                                    }`}
                                    style={{ width: `${veh.fuel_battery_pct}%` }}
                                  ></div>
                                </div>
                              </div>
                            </div>

                            <button
                              onClick={() => {
                                setCurrentView('routes');
                                showToast(`Tracking vehicle ${veh.code} on map.`);
                              }}
                              className="w-full mt-2 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold"
                            >
                              Track on Map →
                            </button>
                          </div>
                        );
                      })}
                    </div>
                  )}

                  {/* Drivers Grid */}
                  {fleetTab === 'drivers' && (
                    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                      {drivers.map(drv => (
                        <div key={drv.id} className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                          <div>
                            <div className="flex items-center justify-between mb-2">
                              <span className="font-mono text-xs font-black text-slate-800">{drv.employee_code}</span>
                              <span className={`text-[10px] font-extrabold px-2 py-0.5 rounded text-white ${
                                drv.status === 'On Duty' ? 'bg-emerald-600' : drv.status === 'On Break' ? 'bg-amber-600' : 'bg-slate-500'
                              }`}>
                                {drv.status}
                              </span>
                            </div>

                            <h4 className="font-bold text-sm text-slate-900">{drv.name}</h4>
                            <p className="text-xs text-slate-500 mb-3">License: {drv.license_no}</p>

                            <div className="space-y-2 text-xs border-y border-slate-100 py-3 mb-3">
                              <div className="flex justify-between">
                                <span className="text-slate-500">Phone:</span>
                                <span className="font-bold text-slate-800">{drv.phone}</span>
                              </div>
                              <div className="flex justify-between">
                                <span className="text-slate-500">Assigned Truck:</span>
                                <span className="font-bold text-emerald-700">{drv.vehicle_code || 'Unassigned'}</span>
                              </div>
                              <div className="flex justify-between">
                                <span className="text-slate-500">Safety Rating:</span>
                                <span className="font-bold text-amber-600">⭐ {drv.rating} / 5.0</span>
                              </div>
                              <div className="flex justify-between">
                                <span className="text-slate-500">Shifts Logged:</span>
                                <span className="font-bold text-slate-800">{drv.shifts_completed} Runs</span>
                              </div>
                            </div>
                          </div>

                          <div className="pt-1">
                            <span className="text-[10px] text-slate-400 block text-center">Authorized Municipal Operator</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

              {/* ======================================================== */}
              {/* 5. ROUTE OPTIMIZER VIEW */}
              {/* ======================================================== */}
              <div className={`space-y-6 ${currentView === 'routes' ? '' : 'hidden'}`}>
                  {/* Header & Mode Switch */}
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                    <div>
                      <span className="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700">Module 3: Fleet Logistics</span>
                      <h2 className="text-xl font-black text-slate-900">Intelligent Collection Route Optimization</h2>
                      <p className="text-xs text-slate-500">Google OR-Tools VRP route calculations with satellite street telemetry.</p>
                    </div>

                    <div className="flex items-center gap-2 flex-wrap">
                      <div className="bg-slate-100 p-1 rounded-xl flex text-xs font-bold">
                        <button
                          onClick={() => setRouteType('smart')}
                          className={`px-3 py-1.5 rounded-lg transition-all ${
                            routeType === 'smart' ? 'bg-[#10B981] text-forest font-black shadow' : 'text-slate-600'
                          }`}
                        >
                          ✨ AI Smart Route (Full Only)
                        </button>
                        <button
                          onClick={() => setRouteType('standard')}
                          className={`px-3 py-1.5 rounded-lg transition-all ${
                            routeType === 'standard' ? 'bg-blue-600 text-white font-black shadow' : 'text-slate-600'
                          }`}
                        >
                          🗺️ Standard Route (All Bins)
                        </button>
                      </div>

                      <div className="bg-slate-100 p-1 rounded-xl flex text-xs font-bold">
                        <button onClick={() => setMapLayer('satellite')} className={`px-2.5 py-1 rounded ${mapLayer === 'satellite' ? 'bg-white shadow text-slate-900' : 'text-slate-600'}`}>Satellite</button>
                        <button onClick={() => setMapLayer('hybrid')} className={`px-2.5 py-1 rounded ${mapLayer === 'hybrid' ? 'bg-white shadow text-slate-900' : 'text-slate-600'}`}>Hybrid</button>
                        <button onClick={() => setMapLayer('street')} className={`px-2.5 py-1 rounded ${mapLayer === 'street' ? 'bg-white shadow text-slate-900' : 'text-slate-600'}`}>Street</button>
                      </div>

                      <button
                        onClick={handleDispatchRoute}
                        className="px-4 py-2 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-black text-xs shadow flex items-center gap-1.5"
                      >
                        🚀 Dispatch Route to Fleet
                      </button>
                    </div>
                  </div>

                  {/* Leaflet Map */}
                  <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                    <div ref={fullMapRef} id="full-map-container" style={{ width: "100%", height: "460px", minHeight: "460px", position: "relative" }} className="rounded-xl overflow-hidden border border-slate-200 mb-4 z-0"></div>

                    {/* Efficiency Comparison Audit Box */}
                    <div className="p-4 rounded-xl bg-emerald-50 border border-emerald-200">
                      <div className="flex justify-between items-center mb-3">
                        <span className="text-xs font-bold text-emerald-900 uppercase">Live Efficiency Audit: AI Smart Path vs. Fixed Sweep</span>
                        <span className="text-[10px] bg-white px-2.5 py-0.5 rounded border border-emerald-200 font-bold text-emerald-800">
                          {routeType === 'smart' ? 'AI Optimized Mode (Google OR-Tools)' : 'Standard Sweep Baseline'}
                        </span>
                      </div>

                      <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
                        <div className="bg-white p-3 rounded-lg border border-slate-200">
                          <span className="text-[11px] text-slate-500 font-medium">Distance Saved</span>
                          <p className="text-xl font-black text-slate-900">{distSaved} km</p>
                          <span className="text-[10px] text-emerald-600 font-bold">↓ {distSavedPct}% cut</span>
                        </div>
                        <div className="bg-white p-3 rounded-lg border border-slate-200">
                          <span className="text-[11px] text-slate-500 font-medium">Driver Time Saved</span>
                          <p className="text-xl font-black text-slate-900">{timeSaved} mins</p>
                          <span className="text-[10px] text-blue-600 font-bold">↓ {timeSavedPct}% faster</span>
                        </div>
                        <div className="bg-white p-3 rounded-lg border border-slate-200">
                          <span className="text-[11px] text-slate-500 font-medium">CO₂ Abated</span>
                          <p className="text-xl font-black text-emerald-700">{co2Saved} kg</p>
                          <span className="text-[10px] text-slate-500">Per collection run</span>
                        </div>
                        <div className="bg-white p-3 rounded-lg border border-slate-200">
                          <span className="text-[11px] text-slate-500 font-medium">Diesel Fuel Saved</span>
                          <p className="text-xl font-black text-slate-900">{fuelSaved} L</p>
                          <span className="text-[10px] text-slate-500">Fuel economy gain</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Waypoint Sequence Table */}
                  <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 className="text-sm font-bold text-slate-900 mb-3">Optimized Waypoint Sequence</h3>
                    <div className="overflow-x-auto">
                      <table className="w-full text-left text-xs">
                        <thead>
                          <tr className="border-b border-slate-200 text-slate-500 font-bold uppercase text-[10px]">
                            <th className="pb-2">Stop #</th>
                            <th className="pb-2">Location / Bin Code</th>
                            <th className="pb-2">Address</th>
                            <th className="pb-2">Fill Level</th>
                            <th className="pb-2">Waste Stream</th>
                            <th className="pb-2">Est. Arrival</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-slate-100">
                          <tr className="bg-emerald-50/40">
                            <td className="py-2.5 font-bold text-emerald-800">0 (Depot)</td>
                            <td className="font-bold text-slate-900">{CITY_DEPOT.name}</td>
                            <td className="text-slate-600">{CITY_DEPOT.address}</td>
                            <td><span className="px-2 py-0.5 rounded bg-emerald-200 text-emerald-800 font-bold text-[10px]">Depot Base</span></td>
                            <td className="text-slate-600">Central Hub</td>
                            <td className="font-bold text-emerald-700">08:00 AM</td>
                          </tr>
                          {(routeType === 'smart' ? fullBins : bins).map((b, i) => {
                            const fillVal = b.fillLevel !== undefined ? b.fillLevel : b.fill;
                            return (
                              <tr key={b.id} className="hover:bg-slate-50">
                                <td className="py-2.5 font-bold text-slate-700">Stop {i + 1}</td>
                                <td className="font-bold text-slate-900">{b.name} ({b.code})</td>
                                <td className="text-slate-600">{b.address}</td>
                                <td>
                                  <span className={`px-2 py-0.5 rounded font-bold text-[10px] text-white ${
                                    fillVal >= 75 ? 'bg-red-600' : 'bg-emerald-600'
                                  }`}>
                                    {Math.round(fillVal)}%
                                  </span>
                                </td>
                                <td className="capitalize text-slate-700">{b.category}</td>
                                <td className="font-medium text-slate-800">08:{15 + i * 14} AM</td>
                              </tr>
                            );
                          })}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>

              {/* ======================================================== */}
              {/* 6. COLLECTION HISTORY VIEW (NEW) */}
              {/* ======================================================== */}
              <div className={`space-y-6 ${currentView === 'history' ? '' : 'hidden'}`}>
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                    <div>
                      <span className="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700">Audit Trail</span>
                      <h2 className="text-xl font-black text-slate-900">Municipal Collection History</h2>
                      <p className="text-xs text-slate-500">Historical fleet dispatches, tonnage gathered, and carbon offsets recorded in SQLite database.</p>
                    </div>

                    <button
                      onClick={() => handleDownloadReport('csv')}
                      className="px-4 py-2 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-bold text-xs flex items-center gap-1.5 shadow"
                    >
                      📥 Download Log (CSV)
                    </button>
                  </div>

                  <div className="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div className="overflow-x-auto">
                      <table className="w-full text-left text-xs">
                        <thead className="bg-slate-50 border-b border-slate-200 text-slate-500 font-bold uppercase text-[10px]">
                          <tr>
                            <th className="p-3.5">Run ID</th>
                            <th className="p-3.5">Date & Time</th>
                            <th className="p-3.5">Assigned Vehicle</th>
                            <th className="p-3.5">Driver</th>
                            <th className="p-3.5">Bins Serviced</th>
                            <th className="p-3.5">Tons Gathered</th>
                            <th className="p-3.5">Distance</th>
                            <th className="p-3.5">Fuel Saved</th>
                            <th className="p-3.5">CO₂ Avoided</th>
                            <th className="p-3.5">Status</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-slate-100">
                          {collectionLogs.map((log) => (
                            <tr key={log.id} className="hover:bg-slate-50">
                              <td className="p-3.5 font-mono font-bold text-slate-900">{log.run_id}</td>
                              <td className="p-3.5 text-slate-600">{log.timestamp}</td>
                              <td className="p-3.5 font-bold text-slate-800">{log.vehicle_code}</td>
                              <td className="p-3.5 text-slate-700">{log.driver_name}</td>
                              <td className="p-3.5 font-bold text-slate-800">{log.bins_serviced_count} Bins</td>
                              <td className="p-3.5 font-black text-slate-900">{log.total_weight_tons} Tons</td>
                              <td className="p-3.5 text-slate-600">{log.distance_km} km</td>
                              <td className="p-3.5 font-bold text-blue-700">{log.fuel_saved_liters} L</td>
                              <td className="p-3.5 font-bold text-emerald-700">{log.co2_avoided_kg} kg</td>
                              <td className="p-3.5">
                                <span className="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-100 text-emerald-800">
                                  {log.status}
                                </span>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>

              {/* ======================================================== */}
              {/* 7. ANALYTICS & PURITY VIEW */}
              {/* ======================================================== */}
              <div className={`space-y-6 ${currentView === 'analytics' ? '' : 'hidden'}`}>
                  <div className="pb-3 border-b border-slate-200">
                    <span className="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700">Municipal Auditing</span>
                    <h2 className="text-xl font-black text-slate-900">Waste Analytics & Purity Breakdown</h2>
                    <p className="text-xs text-slate-500">Long-term diversion efficiency and stream purity benchmarks.</p>
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                      <h3 className="text-sm font-bold text-slate-900 mb-2">Stream Purity Rate (%) by Material</h3>
                      <div className="space-y-3 pt-2">
                        {[
                          { stream: 'Recyclable Plastics', purity: 97.4, color: 'bg-blue-600' },
                          { stream: 'Organic Wet Waste', purity: 96.8, color: 'bg-emerald-600' },
                          { stream: 'Paper & Cardboard', purity: 95.2, color: 'bg-blue-500' },
                          { stream: 'Hazardous / E-Waste', purity: 98.9, color: 'bg-red-600' },
                          { stream: 'Residual / Mixed', purity: 91.5, color: 'bg-amber-600' }
                        ].map((m, i) => (
                          <div key={i}>
                            <div className="flex justify-between text-xs font-semibold mb-1">
                              <span>{m.stream}</span>
                              <span className="font-bold">{m.purity}%</span>
                            </div>
                            <div className="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
                              <div className={`h-full rounded-full ${m.color}`} style={{ width: `${m.purity}%` }}></div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                      <h3 className="text-sm font-bold text-slate-900 mb-2">Zone-by-Zone Fill Telemetry</h3>
                      <div className="space-y-3 pt-2">
                        {[
                          { zone: 'Indiranagar Core', fill: 88.0, status: 'Critical Pickup' },
                          { zone: 'Central Retail & MG Rd', fill: 96.0, status: 'Critical Pickup' },
                          { zone: 'Koramangala Commercial', fill: 94.0, status: 'Critical Pickup' },
                          { zone: 'Transit Core & Majestic', fill: 85.0, status: 'Critical Pickup' },
                          { zone: 'Green Belt & Lalbagh', fill: 52.0, status: 'Normal' }
                        ].map((z, i) => (
                          <div key={i} className="p-3 rounded-xl bg-slate-50 border border-slate-200 flex justify-between items-center text-xs">
                            <div>
                              <p className="font-bold text-slate-900">{z.zone}</p>
                              <span className="text-[10px] text-slate-500">{z.status}</span>
                            </div>
                            <span className="text-sm font-black text-slate-800">{z.fill}% Avg</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>

              {/* ======================================================== */}
              {/* 8. AUDIT REPORTS VIEW */}
              {/* ======================================================== */}
              <div className={`space-y-6 ${currentView === 'reports' ? '' : 'hidden'}`}>
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                    <div>
                      <span className="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700">Official Municipal Audit</span>
                      <h2 className="text-xl font-black text-slate-900">Compliance & Performance Reports</h2>
                      <p className="text-xs text-slate-500">Download formatted reports with timestamped sensor audit trails from SQLite.</p>
                    </div>

                    <div className="flex items-center gap-2">
                      <button
                        onClick={() => handleDownloadReport('json')}
                        className="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs flex items-center gap-2 border border-slate-300"
                      >
                        📄 Download JSON Audit
                      </button>
                      <button
                        onClick={() => handleDownloadReport('csv')}
                        className="px-4 py-2.5 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-bold text-xs flex items-center gap-2 shadow"
                      >
                        📥 Download CSV Audit
                      </button>
                    </div>
                  </div>

                  <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <h3 className="font-bold text-sm text-slate-900">Current Municipal Audit Summary</h3>
                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                      <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                        <span className="text-slate-500">Report Date</span>
                        <p className="font-bold text-slate-900 mt-0.5">{new Date().toLocaleDateString()}</p>
                      </div>
                      <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                        <span className="text-slate-500">Authorized Officer</span>
                        <p className="font-bold text-slate-900 mt-0.5">{currentUser.full_name} ({currentUser.role.toUpperCase()})</p>
                      </div>
                      <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                        <span className="text-slate-500">Purity Rating</span>
                        <p className="font-bold text-emerald-700 mt-0.5">96.4% AAA Grade</p>
                      </div>
                      <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                        <span className="text-slate-500">Total Audit Bins</span>
                        <p className="font-bold text-slate-900 mt-0.5">{bins.length} Active Bins</p>
                      </div>
                    </div>
                  </div>
                </div>

              {/* ======================================================== */}
              {/* 9. SETTINGS & MAP KEY VIEW */}
              {/* ======================================================== */}
              <div className={`space-y-6 max-w-4xl ${currentView === 'settings' ? '' : 'hidden'}`}>
                  <div className="pb-3 border-b border-slate-200">
                    <span className="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700">Configuration</span>
                    <h2 className="text-xl font-black text-slate-900">Platform Settings & Map API Configuration</h2>
                    <p className="text-xs text-slate-500">Manage Mapbox, MapTiler, or Esri high-resolution satellite imagery keys.</p>
                  </div>

                  {/* Map API Key Card */}
                  <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <div className="flex items-center gap-2">
                      <span className="text-lg">🗺️</span>
                      <h3 className="text-base font-bold text-slate-900">Satellite & Street Map Tile Provider</h3>
                    </div>

                    <p className="text-xs text-slate-600 leading-relaxed">
                      EcoRoute AI supports authenticated high-resolution satellite/hybrid tiles via MapTiler or Mapbox. When no key is entered, it automatically defaults to <b>Esri World Imagery + Labels</b> (free, crisp aerial imagery with zero 403 or watermark issues).
                    </p>

                    <div className="space-y-3 pt-2">
                      <div className="flex items-center gap-4 text-xs font-semibold">
                        <label className="flex items-center gap-1.5 cursor-pointer">
                          <input
                            type="radio"
                            name="mapProv"
                            value="esri"
                            checked={mapProvider === 'esri'}
                            onChange={() => setMapProvider('esri')}
                            className="text-emerald-600 focus:ring-emerald-500"
                          />
                          <span>Esri World Imagery (Built-in, Zero-Watermark)</span>
                        </label>
                        <label className="flex items-center gap-1.5 cursor-pointer">
                          <input
                            type="radio"
                            name="mapProv"
                            value="maptiler"
                            checked={mapProvider === 'maptiler'}
                            onChange={() => setMapProvider('maptiler')}
                            className="text-emerald-600 focus:ring-emerald-500"
                          />
                          <span>MapTiler Cloud</span>
                        </label>
                        <label className="flex items-center gap-1.5 cursor-pointer">
                          <input
                            type="radio"
                            name="mapProv"
                            value="mapbox"
                            checked={mapProvider === 'mapbox'}
                            onChange={() => setMapProvider('mapbox')}
                            className="text-emerald-600 focus:ring-emerald-500"
                          />
                          <span>Mapbox Satellite</span>
                        </label>
                      </div>

                      <div>
                        <label className="block text-xs font-bold text-slate-700 mb-1">
                          Custom Map API Key (Optional)
                        </label>
                        <input
                          type="text"
                          value={mapApiKey}
                          onChange={(e) => setMapApiKey(e.target.value)}
                          placeholder="Enter your Mapbox pk.xxx or MapTiler key..."
                          className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-mono focus:ring-2 focus:ring-emerald-500 outline-hidden"
                        />
                      </div>

                      <button
                        onClick={() => saveMapKeySettings(mapApiKey, mapProvider)}
                        className="px-5 py-2 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-bold text-xs shadow transition-all"
                      >
                        Save Map Configuration
                      </button>
                    </div>
                  </div>

                  {/* Municipal Deployment Location */}
                  <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-2">
                        <span className="text-lg">📍</span>
                        <h3 className="text-base font-bold text-slate-900">Municipal Deployment Grid</h3>
                      </div>
                      <span className="px-2.5 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-extrabold uppercase">
                        Default City: Bengaluru
                      </span>
                    </div>

                    <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs pt-1">
                      <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                        <span className="text-slate-500 font-semibold">City Region</span>
                        <p className="font-bold text-slate-900 mt-0.5">Bengaluru, Karnataka, India</p>
                      </div>
                      <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                        <span className="text-slate-500 font-semibold">Depot Coordinates</span>
                        <p className="font-mono font-bold text-slate-900 mt-0.5">12.9756° N, 77.6097° E</p>
                      </div>
                      <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                        <span className="text-slate-500 font-semibold">Active Sensor Fleet</span>
                        <p className="font-bold text-slate-900 mt-0.5">{bins.length} Smart Bins • {vehicles.length} Trucks</p>
                      </div>
                    </div>

                    <div className="p-3 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center gap-3 text-xs text-emerald-900">
                      <span className="text-base">🛡️</span>
                      <p>
                        <b>Strict Human & Non-Waste Shield:</b> Detection models automatically ignore pedestrians, sanitation workers, vehicles, and living beings. Humans are 100% excluded from waste classification.
                      </p>
                    </div>
                  </div>
                </div>

            </main>
          </div>

          {/* ================= MODAL: AUTH / SWITCH ROLE ================= */}
          {authModalOpen && (
            <div className="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
              <div className="bg-white rounded-2xl max-w-md w-full p-6 border shadow-2xl relative animate-fade-in">
                <button
                  onClick={() => setAuthModalOpen(false)}
                  className="absolute top-4 right-4 text-slate-400 hover:text-black font-bold text-lg"
                >
                  ✕
                </button>

                <div className="flex items-center gap-2 mb-2">
                  <span className="text-xl">🔐</span>
                  <h3 className="text-lg font-black text-slate-900">Operator & Admin Authentication</h3>
                </div>
                <p className="text-xs text-slate-500 mb-4">Switch roles or log in with verified municipal credentials.</p>

                <div className="p-3 rounded-xl bg-slate-50 border border-slate-200 mb-4">
                  <span className="text-[10px] font-extrabold uppercase text-slate-400">Current Session</span>
                  <div className="flex items-center justify-between mt-1">
                    <div>
                      <p className="text-xs font-bold text-slate-900">{currentUser.full_name}</p>
                      <span className="text-[11px] text-slate-500">{currentUser.email}</span>
                    </div>
                    <span className={`px-2 py-0.5 rounded text-[10px] font-black uppercase text-white ${
                      currentUser.role === 'admin' ? 'bg-emerald-700' : 'bg-blue-700'
                    }`}>
                      {currentUser.role}
                    </span>
                  </div>
                </div>

                <div className="space-y-2 mb-4">
                  <span className="text-xs font-bold text-slate-700">Quick 1-Click Role Switch:</span>
                  <div className="grid grid-cols-2 gap-2">
                    <button
                      onClick={() => handleAuthSwitch('admin@ecoroute.city', 'admin123')}
                      className={`p-3 rounded-xl border text-left transition-all ${
                        currentUser.role === 'admin'
                          ? 'border-emerald-500 bg-emerald-50 ring-2 ring-emerald-300'
                          : 'border-slate-200 hover:border-emerald-300'
                      }`}
                    >
                      <div className="flex items-center justify-between">
                        <span className="font-black text-xs text-slate-900">Chethan (Admin)</span>
                        <span className="text-[9px] bg-emerald-600 text-white font-bold px-1.5 py-0.2 rounded">ADMIN</span>
                      </div>
                      <p className="text-[10px] text-slate-500 mt-1">Full CRUD, Fleet config, Settings</p>
                    </button>

                    <button
                      onClick={() => handleAuthSwitch('operator@ecoroute.city', 'operator123')}
                      className={`p-3 rounded-xl border text-left transition-all ${
                        currentUser.role === 'operator'
                          ? 'border-blue-500 bg-blue-50 ring-2 ring-blue-300'
                          : 'border-slate-200 hover:border-blue-300'
                      }`}
                    >
                      <div className="flex items-center justify-between">
                        <span className="font-black text-xs text-slate-900">Ramesh (Operator)</span>
                        <span className="text-[9px] bg-blue-600 text-white font-bold px-1.5 py-0.2 rounded">OPERATOR</span>
                      </div>
                      <p className="text-[10px] text-slate-500 mt-1">Field vision scans, Dispatch routes</p>
                    </button>
                  </div>
                </div>

                <div className="text-[11px] text-slate-500 border-t border-slate-100 pt-3">
                  <b>Role Permissions Matrix:</b><br/>
                  • <b>Admin:</b> Full access to Add/Edit/Delete Bins, Fleet vehicles, Drivers, Map Keys.<br/>
                  • <b>Operator:</b> Field inspection, real-time scanning, telemetry monitoring & route dispatch.
                </div>
              </div>
            </div>
          )}

          {/* ================= MODAL: ADD / EDIT BIN ================= */}
          {binModalOpen && (
            <div className="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
              <div className="bg-white rounded-2xl max-w-md w-full p-6 border shadow-2xl relative animate-fade-in">
                <button
                  onClick={() => setBinModalOpen(false)}
                  className="absolute top-4 right-4 text-slate-400 hover:text-black font-bold text-lg"
                >
                  ✕
                </button>

                <h3 className="text-base font-black text-slate-900 mb-1">
                  {binModalMode === 'add' ? 'Add New Smart Bin' : `Edit Bin ${binFormData.name}`}
                </h3>
                <p className="text-xs text-slate-500 mb-4">Configure ultrasonic IoT sensor attributes and location.</p>

                <form onSubmit={handleSaveBin} className="space-y-3 text-xs">
                  <div>
                    <label className="block font-bold text-slate-700 mb-1">Bin Name</label>
                    <input
                      type="text"
                      required
                      value={binFormData.name}
                      onChange={(e) => setBinFormData({ ...binFormData, name: e.target.value })}
                      placeholder="e.g. Indiranagar Metro Gate 1"
                      className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                    />
                  </div>

                  <div className="grid grid-cols-2 gap-2">
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">Zone</label>
                      <input
                        type="text"
                        required
                        value={binFormData.zone}
                        onChange={(e) => setBinFormData({ ...binFormData, zone: e.target.value })}
                        placeholder="e.g. Indiranagar Core"
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      />
                    </div>
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">Waste Stream</label>
                      <select
                        value={binFormData.category}
                        onChange={(e) => setBinFormData({ ...binFormData, category: e.target.value })}
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      >
                        <option value="recyclable">Recyclable (Blue)</option>
                        <option value="organic">Organic (Green)</option>
                        <option value="hazardous">Hazardous (Red)</option>
                        <option value="general">General (Amber)</option>
                      </select>
                    </div>
                  </div>

                  <div>
                    <label className="block font-bold text-slate-700 mb-1">Address / Landmark</label>
                    <input
                      type="text"
                      required
                      value={binFormData.address}
                      onChange={(e) => setBinFormData({ ...binFormData, address: e.target.value })}
                      placeholder="e.g. 100 Feet Rd & CMH Rd"
                      className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                    />
                  </div>

                  <div className="grid grid-cols-3 gap-2">
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">Fill Level (%)</label>
                      <input
                        type="number"
                        min="0"
                        max="100"
                        value={binFormData.fillLevel}
                        onChange={(e) => setBinFormData({ ...binFormData, fillLevel: parseFloat(e.target.value) || 0 })}
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      />
                    </div>
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">Priority</label>
                      <select
                        value={binFormData.priority}
                        onChange={(e) => setBinFormData({ ...binFormData, priority: e.target.value })}
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      >
                        <option value="Critical">Critical</option>
                        <option value="High">High</option>
                        <option value="Normal">Normal</option>
                      </select>
                    </div>
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">Capacity (kg)</label>
                      <input
                        type="number"
                        value={binFormData.capacityKg}
                        onChange={(e) => setBinFormData({ ...binFormData, capacityKg: parseFloat(e.target.value) || 100 })}
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      />
                    </div>
                  </div>

                  <div className="flex gap-2 pt-2">
                    <button
                      type="submit"
                      className="flex-1 py-2.5 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-bold text-xs shadow"
                    >
                      {binModalMode === 'add' ? 'Save New Bin' : 'Update Bin'}
                    </button>
                    <button
                      type="button"
                      onClick={() => setBinModalOpen(false)}
                      className="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 text-xs font-semibold"
                    >
                      Cancel
                    </button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {/* ================= MODAL: ADD VEHICLE ================= */}
          {vehicleModalOpen && (
            <div className="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
              <div className="bg-white rounded-2xl max-w-md w-full p-6 border shadow-2xl relative animate-fade-in">
                <button onClick={() => setVehicleModalOpen(false)} className="absolute top-4 right-4 text-slate-400 hover:text-black font-bold text-lg">✕</button>
                <h3 className="text-base font-black text-slate-900 mb-1">Register Municipal Truck</h3>
                <p className="text-xs text-slate-500 mb-4">Add a new zero-emission collection vehicle to the city fleet.</p>

                <form onSubmit={handleSaveVehicle} className="space-y-3 text-xs">
                  <div>
                    <label className="block font-bold text-slate-700 mb-1">Vehicle Name</label>
                    <input
                      type="text"
                      required
                      value={vehicleFormData.name}
                      onChange={(e) => setVehicleFormData({ ...vehicleFormData, name: e.target.value })}
                      placeholder="e.g. Electric Compactor Epsilon"
                      className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                    />
                  </div>
                  <div className="grid grid-cols-2 gap-2">
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">Model</label>
                      <input
                        type="text"
                        required
                        value={vehicleFormData.model}
                        onChange={(e) => setVehicleFormData({ ...vehicleFormData, model: e.target.value })}
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      />
                    </div>
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">License Plate</label>
                      <input
                        type="text"
                        required
                        value={vehicleFormData.plate_number}
                        onChange={(e) => setVehicleFormData({ ...vehicleFormData, plate_number: e.target.value })}
                        placeholder="KA-01-GC-9999"
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      />
                    </div>
                  </div>

                  <div className="grid grid-cols-2 gap-2">
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">Status</label>
                      <select
                        value={vehicleFormData.status}
                        onChange={(e) => setVehicleFormData({ ...vehicleFormData, status: e.target.value })}
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      >
                        <option value="Available">Available</option>
                        <option value="En Route">En Route</option>
                        <option value="Charging">Charging</option>
                        <option value="Maintenance">Maintenance</option>
                      </select>
                    </div>
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">Assigned Driver</label>
                      <select
                        value={vehicleFormData.driver_id}
                        onChange={(e) => setVehicleFormData({ ...vehicleFormData, driver_id: e.target.value })}
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      >
                        <option value="">Unassigned</option>
                        {drivers.map(d => (
                          <option key={d.id} value={d.id}>{d.name} ({d.employee_code})</option>
                        ))}
                      </select>
                    </div>
                  </div>

                  <div className="flex gap-2 pt-2">
                    <button type="submit" className="flex-1 py-2.5 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-bold text-xs shadow">Save Vehicle</button>
                    <button type="button" onClick={() => setVehicleModalOpen(false)} className="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 text-xs font-semibold">Cancel</button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {/* ================= MODAL: ADD DRIVER ================= */}
          {driverModalOpen && (
            <div className="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
              <div className="bg-white rounded-2xl max-w-md w-full p-6 border shadow-2xl relative animate-fade-in">
                <button onClick={() => setDriverModalOpen(false)} className="absolute top-4 right-4 text-slate-400 hover:text-black font-bold text-lg">✕</button>
                <h3 className="text-base font-black text-slate-900 mb-1">Enroll Municipal Driver</h3>
                <p className="text-xs text-slate-500 mb-4">Register a certified commercial driver for waste collection operations.</p>

                <form onSubmit={handleSaveDriver} className="space-y-3 text-xs">
                  <div>
                    <label className="block font-bold text-slate-700 mb-1">Driver Full Name</label>
                    <input
                      type="text"
                      required
                      value={driverFormData.name}
                      onChange={(e) => setDriverFormData({ ...driverFormData, name: e.target.value })}
                      placeholder="e.g. Ravi Shankar"
                      className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                    />
                  </div>
                  <div className="grid grid-cols-2 gap-2">
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">Phone</label>
                      <input
                        type="text"
                        required
                        value={driverFormData.phone}
                        onChange={(e) => setDriverFormData({ ...driverFormData, phone: e.target.value })}
                        placeholder="+91 98450 XXXXX"
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      />
                    </div>
                    <div>
                      <label className="block font-bold text-slate-700 mb-1">License No</label>
                      <input
                        type="text"
                        required
                        value={driverFormData.license_no}
                        onChange={(e) => setDriverFormData({ ...driverFormData, license_no: e.target.value })}
                        placeholder="KA-01-2022-XXXXX"
                        className="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-hidden"
                      />
                    </div>
                  </div>

                  <div className="flex gap-2 pt-2">
                    <button type="submit" className="flex-1 py-2.5 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-bold text-xs shadow">Enroll Driver</button>
                    <button type="button" onClick={() => setDriverModalOpen(false)} className="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 text-xs font-semibold">Cancel</button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {/* ================= BIN DETAIL INSPECTOR MODAL ================= */}
          {inspectedBin && (
            <div className="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
              <div className="bg-white rounded-2xl max-w-md w-full p-6 border shadow-2xl relative animate-fade-in">
                <button
                  onClick={() => setInspectedBin(null)}
                  className="absolute top-4 right-4 text-slate-400 hover:text-black font-bold text-lg"
                >
                  ✕
                </button>

                <div className="flex items-center gap-2 mb-2">
                  <span className="font-mono text-xs font-black bg-slate-100 px-2 py-0.5 rounded text-slate-800">{inspectedBin.code}</span>
                  <span className={`text-[10px] font-extrabold px-2 py-0.5 rounded text-white ${
                    (inspectedBin.fillLevel || inspectedBin.fill) >= 75 ? 'bg-red-600' : 'bg-emerald-600'
                  }`}>
                    {(inspectedBin.fillLevel || inspectedBin.fill) >= 75 ? 'NEEDS IMMEDIATE PICKUP' : 'CAPACITY NORMAL'}
                  </span>
                </div>

                <h3 className="text-lg font-bold text-slate-900">{inspectedBin.name}</h3>
                <p className="text-xs text-slate-500 mb-4">{inspectedBin.address} ({inspectedBin.zone})</p>

                <div className="space-y-2 text-xs border-y border-slate-100 py-3 mb-4">
                  <div className="flex justify-between">
                    <span className="text-slate-500">Current Fill Level:</span>
                    <span className="font-black text-slate-900">{inspectedBin.fillLevel || inspectedBin.fill}%</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-500">Waste Stream:</span>
                    <span className="capitalize font-bold text-slate-800">{inspectedBin.category}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-500">Collection Priority:</span>
                    <span className="font-bold text-emerald-700">{inspectedBin.priority || 'Normal'}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-500">Battery Telemetry:</span>
                    <span className="font-bold text-emerald-700">{inspectedBin.batteryLevel || inspectedBin.battery}%</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-slate-500">GPS Coordinates:</span>
                    <span className="font-mono text-slate-700">{inspectedBin.lat?.toFixed(4)}, {inspectedBin.lng?.toFixed(4)}</span>
                  </div>
                </div>

                <div className="flex gap-2">
                  <button
                    onClick={() => {
                      setRouteType('smart');
                      setCurrentView('routes');
                      setInspectedBin(null);
                    }}
                    className="flex-1 py-2.5 rounded-xl bg-[#0B3B24] hover:bg-[#0E492D] text-white font-bold text-xs"
                  >
                    View in Route Optimizer
                  </button>
                  <button
                    onClick={() => setInspectedBin(null)}
                    className="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 text-xs font-semibold"
                  >
                    Close
                  </button>
                </div>
              </div>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
